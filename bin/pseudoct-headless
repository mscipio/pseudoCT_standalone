#!/bin/sh

# Stable command-line bridge for the versioned R2010b stdin bootstrap.
set -u

fail() {
    printf 'pseudoct-headless: %s\n' "$1" >&2
    exit "$2"
}

if [ "$#" -ne 2 ]; then
    fail 'usage: pseudoct-headless REQUEST.mat RESULT.mat' 64
fi

# Resolve invocation through PATH and symlinked launchers before locating the
# installation root. The installation can then be moved without editing this
# file or depending on the caller's current directory.
case "$0" in
    */*) launcher=$0 ;;
    *) launcher=$(command -v "$0") || fail 'cannot resolve launcher path' 70 ;;
esac
launcher=$(readlink -f -- "$launcher") || fail 'cannot resolve launcher path' 70
launcher_dir=$(CDPATH= cd -P -- "$(dirname -- "$launcher")" 2>/dev/null && pwd -P) ||
    fail 'cannot resolve installation root' 70
install_root=$(CDPATH= cd -P -- "$launcher_dir/.." 2>/dev/null && pwd -P) ||
    fail 'cannot resolve installation root' 70

caller_dir=$(pwd -P) || fail 'cannot resolve caller directory' 70
case "$1" in
    /*) request_input=$1 ;;
    *) request_input=$caller_dir/$1 ;;
esac
case "$2" in
    /*) result_input=$2 ;;
    *) result_input=$caller_dir/$2 ;;
esac
newline='
'
case "$request_input" in
    *"$newline"*) fail 'request path cannot contain a newline' 65 ;;
esac
case "$result_input" in
    *"$newline"*) fail 'result path cannot contain a newline' 66 ;;
esac

request_path=$(readlink -f -- "$request_input") ||
    fail 'request MAT file is unavailable or unreadable' 65
[ -f "$request_path" ] && [ -r "$request_path" ] ||
    fail 'request MAT file is unavailable or unreadable' 65

# -m canonicalizes a not-yet-created output and resolves existing parent and
# target symlinks, allowing reliable same-file checks without creating files.
result_path=$(readlink -m -- "$result_input") ||
    fail 'result path is invalid' 66
[ -n "$result_path" ] && [ ! -d "$result_path" ] ||
    fail 'result path must name a file' 66
result_parent=$(dirname -- "$result_path")
[ -d "$result_parent" ] && [ -w "$result_parent" ] && [ -x "$result_parent" ] ||
    fail 'result parent is not a writable directory' 66
if [ -e "$result_path" ] && [ ! -w "$result_path" ]; then
    fail 'existing result file is not writable' 66
fi
[ "$request_path" != "$result_path" ] ||
    fail 'request and result paths must differ' 66

matlab_bin=${PSEUDOCT_MATLAB:-/usr/pubsw/common/matlab/7.11/bin/matlab}
case "$matlab_bin" in
    */*) ;;
    *) matlab_bin=$(command -v "$matlab_bin") ||
        fail 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' 69 ;;
esac
matlab_bin=$(readlink -f -- "$matlab_bin") ||
    fail 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' 69
[ -x "$matlab_bin" ] || fail 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' 69
[ -f "$install_root/src/cli/pseudoct_headless_cli_r2010b.m" ] ||
    fail 'versioned MATLAB bootstrap is unavailable' 70

# Only request/result paths are added to the MATLAB environment. Credentials
# remain in the external one-use MAT handoff referenced by the request.
PSEUDOCT_REQUEST_MAT=$request_path
PSEUDOCT_RESULT_MAT=$result_path
export PSEUDOCT_REQUEST_MAT PSEUDOCT_RESULT_MAT
case "$result_parent/" in
    */MR_PET/tmp/*) ;;
    *) fail 'runtime directory must be under the resolved subject MR_PET/tmp' 70 ;;
esac
runtime_dir=$(umask 077; mktemp -d "$result_parent/pseudoct-headless.XXXXXXXX") ||
    fail 'subject runtime directory unavailable' 70
chmod 00700 "$runtime_dir" || fail 'cannot secure subject runtime directory' 70
trap 'rm -rf -- "$runtime_dir"' 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP
export PSEUDOCT_INSTALL_ROOT="$install_root"
export TMPDIR="$runtime_dir" TMP="$runtime_dir" TEMP="$runtime_dir"
export MATLAB_PREFDIR="$runtime_dir/matlab-prefs" MCR_CACHE_ROOT="$runtime_dir/mcr-cache"
cd -P -- "$runtime_dir" || fail 'cannot enter subject runtime directory' 70

# Keep this fixed: no paths or request values are interpolated into MATLAB
# source or command-line expressions. The bootstrap keeps the JVM enabled.
"$matlab_bin" -nodesktop -nosplash -nodisplay <<'MATLAB'
try
    addpath(fullfile(getenv('PSEUDOCT_INSTALL_ROOT'), 'src', 'cli'), '-begin');
    pseudoct_headless_cli_r2010b;
catch
    status = 70;
end
if ~exist('status', 'var') || ~isnumeric(status) || ...
        ~isscalar(status) || ~isfinite(status) || status ~= fix(status) || ...
        status < 0 || status > 255
    status = 70;
end
exit(status);
MATLAB
matlab_status=$?

case "$matlab_status" in
    0|2|3)
        [ -f "$result_path" ] && [ -s "$result_path" ] ||
            fail 'MATLAB returned without a usable result MAT file' 70
        ;;
esac

case "$matlab_status" in
    0)
        exit 0
        ;;
    2)
        exit 2
        ;;
    3)
        exit 3
        ;;
    70)
        printf 'pseudoct-headless: MATLAB dispatch/runtime failure\n' >&2
        exit 70
        ;;
    *)
        printf 'pseudoct-headless: MATLAB startup failed or exited unexpectedly\n' >&2
        exit 70
        ;;
esac
