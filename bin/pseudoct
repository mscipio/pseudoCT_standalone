#!/usr/bin/env bash
# User-facing CLI for MATLAB-serialized pseudoCT Headless API v2 requests.
set -u

EXIT_USAGE=64
EXIT_VALIDATION=65
EXIT_AUTH=66
EXIT_SUBMISSION=67
EXIT_SCIENCE=68
EXIT_RUNTIME=69
profiles='local-current local-mprage-only mlsc-current mlsc-mprage-only'
operation_phase=not_started

usage() {
    cat <<'USAGE'
Usage:
  pseudoct validate --profile PROFILE (--mprage FILE [--umap FILE] | --config job.json) [options]
  pseudoct run      --profile PROFILE (--mprage FILE [--umap FILE] | --config job.json) [options]

Options:
  --profile NAME                  Canonical supported profile (required)
  --mprage FILE --umap FILE       One subject; UMAP may be omitted for discovery
  --config job.json               Multi-subject JSON with mprage[] and optional umap[]
  --correct-aliasing yes|no       Override profile default
  --recenter-before-normalization yes|no
  --cleanup-on-success yes|no
  --current-artifact-root PATH    Current-profile validation override
  --group-account ACCOUNT        MLSC account selection for run
  --host-key-file FILE            Optional MLSC strict host-key input
  --credential-handoff FILE       Existing authorized single-use handoff
  --format text|jsonl             Output format (default: text)
  -h, --help                      Show this help

Exit codes: 0 validated/completed, 64 usage/config, 65 invalid request,
66 authentication, 67 submission failure, 68 scientific failure/unverified,
69 launcher/runtime failure.
USAGE
}

error_record() {
    code=$1
    message=$2
    error_class=${3:-}
    if [ -z "$error_class" ]; then
        case "$code" in
            64) error_class=USAGE_OR_CONFIG_ERROR ;;
            65) error_class=INVALID_REQUEST ;;
            66) error_class=AUTHENTICATION_FAILED ;;
            67) error_class=SUBMISSION_FAILED ;;
            68) error_class=SCIENTIFIC_FAILURE_OR_UNVERIFIED ;;
            *) error_class=CLI_RUNTIME_ERROR ;;
        esac
    fi
    if [ "${format:-text}" = jsonl ]; then
        python3 - "${invocation_id:-}" "${action:-unknown}" \
            "${profile:-}" "$error_class" "$message" "$code" \
            "$operation_phase" <<'PY'
import json, sys
invocation, action, profile, error_code, message, exit_code, phase = sys.argv[1:]
unknown_submit = phase == "submit_called"
unknown_reason = "unknown: submit outcome not established"
record = {
    "type": "result", "invocation_id": invocation or None,
    "action": action, "profile": profile or None, "outcome": "failed",
    "exit_code": int(exit_code),
    "headless_dispatch_returned": True if unknown_submit else False,
    "dispatch_status": None if unknown_submit else "not_dispatched",
    "submission_status": None if unknown_submit else "not_attempted",
    "scheduler_submission_accepted": None if unknown_submit else False,
    "scientific_completion": None,
    "scientific_completion_reason": "No verified scientific result is available because the CLI operation stopped before completion.",
    "job_ids": [], "error_code": error_code, "error_message": message,
}
if unknown_submit:
    record["dispatch_status_reason"] = unknown_reason
    record["submission_status_reason"] = unknown_reason
    record["scheduler_submission_accepted_reason"] = unknown_reason
print(json.dumps(record, separators=(",", ":")))
PY
    fi
    printf 'pseudoct: %s\n' "$message" >&2
    exit "$code"
}

if [ "$#" -lt 1 ]; then
    usage >&2
    exit "$EXIT_USAGE"
fi
action=$1
shift
case "$action" in
    validate|run) ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'pseudoct: command must be validate or run.\n' >&2; exit "$EXIT_USAGE" ;;
esac

profile=''
mprage=''
umap=''
config=''
correct_aliasing=''
recenter=''
cleanup_success=''
artifact_root=''
group_account=''
host_key_file=''
credential_handoff=''
format=text
seen_mprage=0
seen_umap=0
seen_config=0

need_value() {
    [ "$#" -ge 2 ] || error_record "$EXIT_USAGE" "An option is missing its value."
}

while [ "$#" -gt 0 ]; do
    option=$1
    shift
    case "$option" in
        --profile|--mprage|--umap|--config|--correct-aliasing|\
        --recenter-before-normalization|--cleanup-on-success|\
        --current-artifact-root|--group-account|--host-key-file|\
        --credential-handoff|--format)
            need_value "$option" "$@"
            value=$1
            shift
            ;;
        --profile=*) value=${option#*=}; option=--profile ;;
        --mprage=*) value=${option#*=}; option=--mprage ;;
        --umap=*) value=${option#*=}; option=--umap ;;
        --config=*) value=${option#*=}; option=--config ;;
        --correct-aliasing=*) value=${option#*=}; option=--correct-aliasing ;;
        --recenter-before-normalization=*) value=${option#*=}; option=--recenter-before-normalization ;;
        --cleanup-on-success=*) value=${option#*=}; option=--cleanup-on-success ;;
        --current-artifact-root=*) value=${option#*=}; option=--current-artifact-root ;;
        --group-account=*) value=${option#*=}; option=--group-account ;;
        --host-key-file=*) value=${option#*=}; option=--host-key-file ;;
        --credential-handoff=*) value=${option#*=}; option=--credential-handoff ;;
        --format=*) value=${option#*=}; option=--format ;;
        -h|--help) usage; exit 0 ;;
        *) error_record "$EXIT_USAGE" "Unknown option: $option" ;;
    esac
    case "$option" in
        --profile) [ -z "$profile" ] || error_record "$EXIT_USAGE" 'Specify --profile only once.'; profile=$value ;;
        --mprage) [ "$seen_mprage" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --mprage only once.'; mprage=$value; seen_mprage=1 ;;
        --umap) [ "$seen_umap" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --umap only once.'; umap=$value; seen_umap=1 ;;
        --config) [ "$seen_config" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --config only once.'; config=$value; seen_config=1 ;;
        --correct-aliasing) correct_aliasing=$value ;;
        --recenter-before-normalization) recenter=$value ;;
        --cleanup-on-success) cleanup_success=$value ;;
        --current-artifact-root) artifact_root=$value ;;
        --group-account) group_account=$value ;;
        --host-key-file) host_key_file=$value ;;
        --credential-handoff) credential_handoff=$value ;;
        --format) format=$value ;;
    esac
done

case " $profiles " in *" $profile "*) ;; *) error_record "$EXIT_USAGE" 'A supported --profile is required.' ;; esac
case "$format" in text|jsonl) ;; *) error_record "$EXIT_USAGE" '--format must be text or jsonl.' ;; esac
if [ "$seen_config" -eq 1 ]; then
    [ "$seen_mprage" -eq 0 ] && [ "$seen_umap" -eq 0 ] || \
        error_record "$EXIT_USAGE" 'Use either --config or single-subject --mprage/--umap flags.'
    [ -f "$config" ] && [ -r "$config" ] || \
        error_record "$EXIT_USAGE" 'The job configuration file is unavailable.'
else
    [ "$seen_mprage" -eq 1 ] || error_record "$EXIT_USAGE" 'Specify --mprage or --config.'
fi
for flag_value in "$correct_aliasing" "$recenter" "$cleanup_success"; do
    case "$flag_value" in ''|yes|no) ;; *) error_record "$EXIT_USAGE" 'Processing options accept only yes or no.' ;; esac
done
case "$profile" in
    local-current|local-mprage-only) backend=local ;;
    mlsc-current|mlsc-mprage-only) backend=mlsc ;;
esac
case "$profile" in *mprage-only*) mprage_only=1 ;; *) mprage_only=0 ;; esac
if [ "$mprage_only" -eq 1 ] && [ "$seen_umap" -eq 1 ]; then
    error_record "$EXIT_USAGE" 'MPRAGE-only profiles do not accept --umap.'
fi
if [ -n "$artifact_root" ]; then
    case "$profile" in mlsc-current|mlsc-mprage-only|local-current|local-mprage-only) ;; *) error_record "$EXIT_USAGE" '--current-artifact-root requires a current profile.' ;; esac
fi
if [ -n "$group_account" ] && [ "$backend" != mlsc ]; then
    error_record "$EXIT_USAGE" '--group-account is available only for MLSC profiles.'
fi
if [ -n "$host_key_file" ] && [ "$backend" != mlsc ]; then
    error_record "$EXIT_USAGE" '--host-key-file is available only for MLSC profiles.'
fi
if [ -n "$credential_handoff" ] && { [ "$action" != run ] || [ "$backend" = local ]; }; then
    error_record "$EXIT_USAGE" '--credential-handoff is valid only for remote run.'
fi
case "$group_account$artifact_root$host_key_file$credential_handoff" in *$'\n'*|*$'\r'*) error_record "$EXIT_USAGE" 'CLI text values cannot contain line breaks.' ;; esac
if [ -n "$credential_handoff" ]; then
    credential_handoff=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$credential_handoff") || \
        error_record "$EXIT_USAGE" 'Credential handoff path is invalid.'
fi

root_dir=$(CDPATH= cd -P -- "$(dirname -- "$(readlink -f -- "$0")")/.." 2>/dev/null && pwd -P) || \
    error_record "$EXIT_RUNTIME" 'Cannot resolve pseudoCT installation root.'
# Resolve the request's owning subject before creating ANY runtime files.
# A multi-subject request's CLI transport belongs to its first subject;
# scientific runners still allocate beneath each individual job.temp_dir.
umask 077
subject_temp=$(python3 - "$config" "$mprage" "$seen_config" <<'PY'
import json, os, sys
try:
    if sys.argv[3] == '1':
        with open(sys.argv[1], encoding='utf-8') as f:
            job = json.load(f)
        paths = job['mprage']
        if not isinstance(paths, list) or not paths:
            raise ValueError()
        value = paths[0]
    else:
        value = sys.argv[2]
    if not isinstance(value, str) or not value or any(c in value for c in '\0\r\n'):
        raise ValueError()
    path = os.path.abspath(os.path.expanduser(value))
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        raise ValueError()
    series = os.path.dirname(path)
    search = series
    processing_root = ''
    while os.path.basename(search).lower() != 'mr':
        if not processing_root and os.path.basename(search).lower() == 'mr_pet':
            processing_root = search
        parent = os.path.dirname(search)
        if parent == search:
            search = ''
            break
        search = parent
    subject = os.path.dirname(search) if search else (
        os.path.dirname(processing_root) if processing_root else os.path.dirname(series))
    target = os.path.join(subject, 'MR_PET', 'tmp')
    if os.path.islink(target):
        raise ValueError()
    os.makedirs(target, mode=0o700, exist_ok=True)
    print(target)
except (OSError, ValueError, TypeError, KeyError):
    raise SystemExit(1)
PY
) || error_record "$EXIT_RUNTIME" 'Cannot resolve a writable subject MR_PET/tmp directory.'
umask 077
tmp_dir=$(mktemp -d "$subject_temp/pseudoct-cli.XXXXXXXX" 2>/dev/null) || \
    error_record "$EXIT_RUNTIME" 'Cannot create a private temporary directory.'
chmod 00700 "$tmp_dir" || error_record "$EXIT_RUNTIME" 'Cannot secure the temporary directory.'
secret_dir=''
handoff_registry=$tmp_dir/handoff-path.txt
tty_state=''
cleanup() {
    if [ -n "$tty_state" ] && [ -r /dev/tty ]; then
        stty "$tty_state" < /dev/tty 2>/dev/null || true
    fi
    if [ -n "$secret_dir" ] && [ -d "$secret_dir" ]; then
        python3 - "$secret_dir/login" <<'PY' >/dev/null 2>&1 || true
import os, sys
path = sys.argv[1]
try:
    with open(path, "r+b", buffering=0) as f:
        size = os.fstat(f.fileno()).st_size
        f.write(b"\0" * size)
    os.unlink(path)
except OSError:
    pass
try:
    os.rmdir(os.path.dirname(path))
except OSError:
    pass
PY
    fi
    if [ -n "$handoff_registry" ] && [ -f "$handoff_registry" ]; then
        python3 - "$handoff_registry" <<'PY' >/dev/null 2>&1 || true
import os, re, stat, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as registry:
        path = registry.readline().rstrip("\n")
    if not re.fullmatch(r"/dev/shm/pseudo_CT_credentials_[A-Za-z0-9_.-]+/credentials\.mat", path):
        raise OSError("invalid private handoff path")
    directory = os.path.dirname(path)
    directory_info = os.lstat(directory)
    if not stat.S_ISDIR(directory_info.st_mode) or directory_info.st_mode & 0o077:
        raise OSError("unsafe private handoff directory")
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
        raise OSError("unsafe private handoff file")
    fd = os.open(path, os.O_WRONLY | os.O_NOFOLLOW)
    try:
        remaining = os.fstat(fd).st_size
        while remaining:
            count = os.write(fd, b"\0" * min(remaining, 4096))
            if count <= 0:
                raise OSError("handoff overwrite failed")
            remaining -= count
    finally:
        os.close(fd)
    os.unlink(path)
    os.rmdir(directory)
except OSError:
    pass
PY
    fi
    if [ -n "${tmp_dir:-}" ] && [ -d "$tmp_dir" ]; then
        rm -rf -- "$tmp_dir"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# MATLAB/MCR caches, crash diagnostics and Python subprocess temporaries must
# share the resolved subject location, never the installation or system temp.
export TMPDIR="$tmp_dir" TMP="$tmp_dir" TEMP="$tmp_dir"
export MATLAB_PREFDIR="$tmp_dir/matlab-prefs" MCR_CACHE_ROOT="$tmp_dir/mcr-cache"
export PSEUDOCT_RUNTIME_DIR="$tmp_dir"

invocation_id=$(uuidgen | tr 'A-F' 'a-f') || error_record "$EXIT_RUNTIME" 'Cannot generate an invocation UUID.'
# Private index of relative MR_PET run-log paths reported by the lifecycle.
# Only this scratch index is removed by cleanup(); the subject's persistent
# pseudoct-run-*.log files are never deleted by the CLI.
run_log_index=$tmp_dir/run-logs.txt
: > "$run_log_index" || error_record "$EXIT_RUNTIME" 'Cannot create the private run-log index.'
input_file=$tmp_dir/cli-input.txt
validate_request=$tmp_dir/validate-request.mat
validate_result=$tmp_dir/validate-result.mat
submit_request=$tmp_dir/submit-request.mat
submit_result=$tmp_dir/submit-result.mat
summary_file=$tmp_dir/result-summary.txt

if ! python3 - "$input_file" "$profile" "$invocation_id" "$config" \
    "$mprage" "$umap" "$seen_config" "$seen_umap" "$correct_aliasing" \
    "$recenter" "$cleanup_success" "$artifact_root" "$group_account" \
    "$host_key_file" <<'PY'
import json, os, sys
output, profile, invocation, config_path, mprage, umap, has_config, has_umap, aliasing, recenter, cleanup, artifact_root, account, host_key = sys.argv[1:]

def fail(message):
    print("pseudoct: " + message, file=sys.stderr)
    raise SystemExit(64)

def one_line(value, label):
    if not isinstance(value, str) or not value or any(c in value for c in "\0\r\n"):
        fail(label + " must be non-empty text without line breaks.")
    return os.path.abspath(os.path.expanduser(value))

if has_config == "1":
    try:
        with open(config_path, "r", encoding="utf-8") as f:
            job = json.load(f)
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("job configuration is not readable valid JSON.")
    if not isinstance(job, dict) or set(job) - {"mprage", "umap"} or "mprage" not in job:
        fail("job JSON must contain mprage[] and optional umap[] only.")
    mprages = job["mprage"]
    umaps = job.get("umap")
    if not isinstance(mprages, list) or not mprages:
        fail("job JSON mprage must be a non-empty array of paths.")
    if umaps is not None and (not isinstance(umaps, list) or len(umaps) != len(mprages)):
        fail("job JSON umap must be an array positionally paired with mprage.")
    mprages = [one_line(v, "MPRAGE path") for v in mprages]
    if umaps is not None:
        umaps = [one_line(v, "UMAP path") for v in umaps]
else:
    mprages = [one_line(mprage, "MPRAGE path")]
    umaps = [one_line(umap, "UMAP path")] if has_umap == "1" else None

if "mprage-only" in profile and umaps is not None:
    fail("MPRAGE-only profiles do not accept UMAP paths.")
if "mprage-only" not in profile and umaps is not None and len(umaps) != len(mprages):
    fail("UMAP paths must be positionally paired with MPRAGE paths.")
if artifact_root:
    artifact_root = one_line(artifact_root, "Current artifact root")
if host_key:
    host_key = one_line(host_key, "Host-key file")
values = [profile, invocation, str(len(mprages)), "1" if umaps is not None else "0"]
values.extend(mprages)
if umaps is not None:
    values.extend(umaps)
values.extend(["1" if aliasing == "yes" else "0" if aliasing == "no" else "",
               "1" if recenter == "yes" else "0" if recenter == "no" else "",
               "1" if cleanup == "yes" else "0" if cleanup == "no" else "",
               artifact_root, account, host_key])
with open(output, "x", encoding="utf-8", newline="\n") as f:
    f.write("\n".join(values) + "\n")
os.chmod(output, 0o600)
PY
then
    error_record "$EXIT_USAGE" 'Job configuration or input paths are invalid.'
fi

matlab_bin=${PSEUDOCT_MATLAB:-/usr/pubsw/common/matlab/7.11/bin/matlab}
if [ ! -x "$matlab_bin" ]; then
    if command -v "$matlab_bin" >/dev/null 2>&1; then
        matlab_bin=$(command -v "$matlab_bin")
    else
        error_record "$EXIT_RUNTIME" 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path.'
    fi
fi

matlab_support() {
    support_mode=$1
    (
    cd -- "$tmp_dir" || exit 69
    PSEUDOCT_CLI_ROOT="$root_dir" PSEUDOCT_CLI_MODE="$support_mode" \
    PSEUDOCT_CLI_INPUT="$input_file" PSEUDOCT_CLI_REQUEST="$2" \
    PSEUDOCT_CLI_RESULT="${3:-}" PSEUDOCT_CLI_SUMMARY="${4:-}" \
    PSEUDOCT_CLI_INVOCATION="$invocation_id" PSEUDOCT_CLI_PROFILE="$profile" \
    PSEUDOCT_CLI_ACTION="$5" PSEUDOCT_CLI_HANDOFF="${credential_handoff:-}" \
    "$matlab_bin" -nodesktop -nosplash -nodisplay <<'MATLAB' \
        >"$tmp_dir/matlab-diagnostics-support-$support_mode.log" 2>&1
try
    root = getenv('PSEUDOCT_CLI_ROOT');
    addpath(root, '-begin');
    runtime_dirs = {'api'; 'cli'; 'gui'; 'orchestration'; 'backends'; ...
        'config'; 'io'; 'qc'};
    for ii = 1:length(runtime_dirs)
        path_here = fullfile(root, 'src', runtime_dirs{ii});
        if exist(path_here, 'dir') == 7
            addpath(genpath(path_here), '-begin');
        end
    end
    status = pseudoct_cli_bridge(getenv('PSEUDOCT_CLI_MODE'));
catch ME
    fprintf(2, 'pseudoct: MATLAB CLI support failed (%s).\n', ME.identifier);
    status = 70;
end
if ~exist('status', 'var') || ~isnumeric(status) || ~isscalar(status)
    status = 70;
end
exit(status);
MATLAB
    )
}

run_headless() {
    phase=$1
    request_path=$2
    result_path=$3
    set +e
    python3 - "$root_dir/bin/pseudoct-headless" "$request_path" \
        "$result_path" "$format" "$tmp_dir/matlab-diagnostics-$phase.log" \
        "$invocation_id" "$run_log_index" "$profile" <<'PY'
import json
import os
import re
import selectors
import subprocess
import sys

launcher, request_path, result_path, output_format, diagnostics_path, \
    invocation_id, run_log_index, run_profile = sys.argv[1:]
environment = os.environ.copy()
environment["PSEUDOCT_CLI_OUTPUT"] = "1"
# Non-secret correlation only: names the per-run log and a private index of
# its relative MR_PET path (the CLI scratch copy is removed on exit; the
# subject's own run log never is).
environment["PSEUDOCT_CLI_INVOCATION_ID"] = invocation_id
environment["PSEUDOCT_CLI_LOG_INDEX"] = run_log_index

# The public stage of a Local Current event (10 stages with DICOM output, 9
# for NIfTI-only) is assigned by the Local Current adapter/orchestrator and
# carried by the canonical event; the presenter blanks the STAGE cell on
# continuation rows while every JSONL record keeps the full stage. This
# transport passes stage values through: no raw-number remapping and no
# policy reading.
BARE_COMPILED_MARKER = re.compile(r"(?<!stage )(?<!stage\t)\[\d+/\d+\]", re.I)

def remap_stage(value):
    return value

# Recognize public TIME SUBJECT [n/m] STATUS rows by their fields, not column
# padding. The presenter uses --:--:-- when no source timestamp is available.
TABLE_ROW = re.compile(
    r"^((?:\d\d:\d\d:\d\d|--:--:--)[ \t]+\S+[ \t]+)(\[\d+/\d+\])"
    r"([ \t]+(?:ACTIVE|DONE|SKIPPED|INFO|WARN|ERROR|CANCELLED|VERIFIED)\b.*)$",
    re.S)

def table_row_stage(text):
    return TABLE_ROW.match(text)

def remap_table_row(text):
    return text

def remap_stage_markers(text):
    return text

def redact_secrets(text):
    # Credentials are filtered before anything is persisted, including the raw
    # private capture below.
    return re.sub(
        r"(?i)(username|user|password|passphrase|account|token|secret)"
        r"([ \t]*[:=][ \t]*|[ \t]+)[^ \t,;]+",
        lambda match: match.group(1) + match.group(2) + "<redacted>", text)
if output_format == "jsonl":
    environment["PSEUDOCT_OUTPUT_FORMAT"] = "jsonl"
else:
    environment.pop("PSEUDOCT_OUTPUT_FORMAT", None)

def strip_prompts(text):
    candidate = text.lstrip()
    while candidate.startswith(">>"):
        candidate = candidate[2:].lstrip()
    return candidate

def sanitize_message(text):
    # Keep this in lockstep with local_sanitize_message in the shared MATLAB
    # formatter. Structured callers sanitize only message fields; preserve
    # stage markers in free text from generic slash-path redaction.
    def short_hash(value):
        hash_value = 5381
        for character in value:
            hash_value = (hash_value * 33 + ord(character)) % 4294967296
        return format(hash_value, "08x")

    stage_markers = []

    def hold_stage_marker(match):
        stage_markers.append(match.group(0))
        return "PSEUDOCTSTAGEMARKER" + str(len(stage_markers) - 1) + "-X"

    text = re.sub(r"(?i)\[(?:stage[ \t]+)?\d+/\d+\]",
                  hold_stage_marker, text)
    dicom_names = re.findall(
        r"(?i)(?:[A-Za-z]:\\|/)?[^ \t,;:()]*\.dcm", text)
    for name in dicom_names:
        text = text.replace(name, "DICOM-" + short_hash(name))
    # Redact path-shaped tokens only: absolute (/x, ~/x, ./x, ../x) tokens and
    # relative multi-segment tokens that have a segment naming a subject-data
    # directory (MR_PET, MR, pseudo_muMAP, tmp) or a segment ending in a file
    # extension. Relative prose such as registration/warping is preserved, as
    # is exactly the approved MR_PET/pseudoct-run-*.log disclosure.
    boundary = r"(?<![^\s=\'\"(\[<,;:])"
    text = re.sub(boundary + r"(?:~|\.{1,2})?/[^ \t,;:()]+", "<path>", text)
    text = re.sub(
        boundary + r"(?!MR_PET/pseudoct-run-[0-9A-Za-z-]+\.log(?![\w.\-/]))"
        r"(?=[\w.\-/]*?(?:(?<![\w.\-])(?:MR_PET|MR|pseudo_muMAP|tmp)(?![\w.\-])"
        r"|\.(?=[0-9]*[A-Za-z])[A-Za-z0-9]{1,5}(?![\w.\-])))"
        r"[\w.\-]+(?:/[\w.\-]+)+",
        "<path>", text)
    text = re.sub(r"[A-Za-z]:\\[^ \t,;:()]+", "<path>", text)
    text = re.sub(
        r"(?i)(username|user|password|passphrase|account|token|secret)"
        r"([ \t]*[:=][ \t]*|[ \t]+)[^ \t,;]+",
        lambda match: match.group(1) + match.group(2) + "<redacted>", text)
    text = re.sub(r"[\r\n]+", " | ", text)
    for index, marker in enumerate(stage_markers):
        text = text.replace("PSEUDOCTSTAGEMARKER" + str(index) + "-X", marker)
    return text

def sanitize_console_line(text):
    # Newlines delimit captured transport lines; preserve the terminator after
    # sanitizing the line content, matching the MATLAB sanitizer's treatment
    # of message text rather than displaying a trailing separator.
    if text.endswith("\r\n"):
        return sanitize_message(text[:-2]) + "\r\n"
    if text.endswith(("\n", "\r")):
        return sanitize_message(text[:-1]) + text[-1:]
    return sanitize_message(text)

def forward_line(text, channel):
    safe_text = sanitize_console_line(text)
    print(safe_text, end="" if text.endswith(("\n", "\r")) else "\n",
          file=sys.stderr if channel == "stderr" else sys.stdout, flush=True)

def matlab_noise(text):
    value = text.strip()
    if not value:
        return True
    lowered = " ".join(value.split()).lower()
    if lowered.startswith((
            "matlab is", "copyright", "the mathworks, inc.",
            "version ", "for product information", "to get started")):
        return True
    if lowered.startswith("pseudoct-headless: validation ready for "):
        return True
    if lowered in ("< m a t l a b (r) >", "august 16, 2010"):
        return True
    if value == ">>" or value.startswith(">>") and not strip_prompts(value):
        return True
    if "no window system found" in lowered or (
            "java option" in lowered and "mwt" in lowered and
            "ignored" in lowered):
        return True
    if lowered.startswith("adding ganymed-ssh2 to the java path"):
        return True
    if lowered.startswith("javaaddpath("):
        return True
    if lowered.startswith("just added ganymed-ssh2 to matlab's dynamic java classpath"):
        return True
    return False

text_header_state = {"seen": False, "suppressing_duplicate": False,
                     "rule_pending": False}
TABLE_HEADER = re.compile(r"^TIME\s+SUBJECT\s+STAGE\s+STATUS\s+MESSAGE\s*$")
TABLE_RULE = re.compile(r"^-{20,}\s*$")
header_marker = os.path.join(os.path.dirname(diagnostics_path),
                             "table-header-seen")

def is_header_continuation(text):
    value = text.strip()
    return (not value or value.startswith(("Started:", "Subjects:",
                                           "TIME      SUBJECT STAGE")) or
            value == "-" * 67)

class RedactingWriter:
    def __init__(self, stream):
        self.stream = stream

    def write(self, text):
        return self.stream.write(redact_secrets(text))

    def flush(self):
        return self.stream.flush()

    def close(self):
        return self.stream.close()

def write_line(channel, raw, diagnostics):
    text = raw.decode("utf-8", "replace")
    if channel == "stderr":
        diagnostics.write("[stderr] " + text)
        diagnostics.flush()
        return
    candidate = strip_prompts(text)
    if matlab_noise(candidate):
        diagnostics.write("[" + channel + "] " + text)
        diagnostics.flush()
        return
    if channel == "stdout" and BARE_COMPILED_MARKER.search(candidate) and \
            not candidate.lstrip().startswith("{") and \
            not table_row_stage(candidate.rstrip("\r\n")):
        # Compiled-runner [N/8] and SPM batch markers are log-only: they are
        # not orchestration stages and never appear in public output. Public
        # presenter table rows and JSON progress records are exempt.
        diagnostics.write("[stdout compiled marker] " + text)
        diagnostics.flush()
        return
    if channel == "stdout" and output_format != "jsonl":
        header_line = candidate.rstrip("\r\n")
        # Each MATLAB phase (validate, submit) is a new process with its own
        # presenter, which prints the table header again. The first header
        # (and its rule) is public output; later ones are diverted. The
        # "seen" marker is a file next to the diagnostics so it survives
        # across the per-phase transport processes. Rows are never touched.
        if text_header_state["rule_pending"]:
            text_header_state["rule_pending"] = False
            if TABLE_RULE.match(header_line):
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
        if TABLE_HEADER.match(header_line):
            if os.path.exists(header_marker):
                text_header_state["rule_pending"] = True
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            try:
                open(header_marker, "w").close()
            except OSError:
                pass
        if text_header_state["suppressing_duplicate"]:
            if is_header_continuation(header_line):
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            text_header_state["suppressing_duplicate"] = False
        if header_line.startswith("pseudoCT |"):
            if text_header_state["seen"]:
                text_header_state["suppressing_duplicate"] = True
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            text_header_state["seen"] = True
    if channel == "stdout" and output_format == "jsonl":
        try:
            value = json.loads(candidate)
        except Exception:
            forward_line(candidate, "stderr")
            return
        if isinstance(value, dict) and value.get("type") == "progress":
            if isinstance(value.get("message"), str):
                value["message"] = remap_stage_markers(
                    sanitize_message(value["message"]))
            if "stage" in value:
                mapped_stage = remap_stage(value["stage"])
                if mapped_stage is None:
                    value.pop("stage", None)
                    value.pop("stage_reason", None)
                else:
                    value["stage"] = mapped_stage
            for field_name in ("subject", "stage", "status", "job"):
                field_value = value.get(field_name)
                missing_context = field_value is None or field_value == "" or \
                    (isinstance(field_value, str) and
                     field_value.lower() in ("unavailable", "null"))
                if field_name == "subject" and isinstance(field_value, str) and \
                        field_value.lower() == "run":
                    missing_context = True
                if missing_context:
                    value.pop(field_name, None)
                    value.pop(field_name + "_reason", None)
            print(json.dumps(value, separators=(",", ":"), ensure_ascii=False), flush=True)
        else:
            forward_line(candidate, "stderr")
        return
    if channel == "stdout":
        try:
            value = json.loads(candidate)
        except Exception:
            body = candidate.rstrip("\r\n")
            forward_line(remap_table_row(body) + candidate[len(body):], "stdout")
        else:
            if isinstance(value, dict) and value.get("type") == "progress":
                message = remap_stage_markers(
                    sanitize_message(str(value.get("message", ""))))
                public_stage = remap_stage(value.get("stage", ""))
                fields = [value.get("timestamp", ""), value.get("level", ""),
                          value.get("subject", ""), public_stage or "",
                          value.get("status", ""), message]
                print(" | ".join(str(item) for item in fields if item not in (None, "")),
                      flush=True)
            else:
                forward_line(candidate, "stdout")

try:
    diagnostics_fd = os.open(
        diagnostics_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    diagnostics = RedactingWriter(
        os.fdopen(diagnostics_fd, "w", encoding="utf-8", newline=""))
except OSError:
    print("pseudoct: could not open diagnostics capture",
          file=sys.stderr, flush=True)
    raise SystemExit(70)

selector = None
try:
    process = subprocess.Popen([launcher, request_path, result_path], env=environment,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               bufsize=0)
    selector = selectors.DefaultSelector()
    streams = {}
    for channel, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
        selector.register(stream, selectors.EVENT_READ, channel)
        streams[stream.fileno()] = {"channel": channel, "stream": stream, "pending": b""}
    while selector.get_map():
        for key, _ in selector.select():
            stream = key.fileobj
            state = streams[stream.fileno()]
            chunk = os.read(stream.fileno(), 4096)
            if not chunk:
                selector.unregister(stream)
                if state["pending"]:
                    write_line(state["channel"], state["pending"], diagnostics)
                stream.close()
                continue
            state["pending"] += chunk
            while b"\n" in state["pending"]:
                line, state["pending"] = state["pending"].split(b"\n", 1)
                write_line(state["channel"], line + b"\n", diagnostics)
    run_status = process.wait()
except Exception as error:
    try:
        diagnostics.write("[transport] launcher=" + repr(launcher) +
                          " error=" + repr(error) + "\n")
        diagnostics.flush()
    except OSError:
        pass
    # The caller maps launch/transport failure to the documented runtime code 69.
    run_status = 69
finally:
    if selector is not None:
        try:
            selector.close()
        except Exception:
            pass
    try:
        diagnostics.close()
    except OSError:
        pass
raise SystemExit(run_status)
PY
    run_status=$?
    set -u
    return "$run_status"
}

