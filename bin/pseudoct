python3 - "$summary_file" "$invocation_id" "$profile" "$action" "$format" "$backend" "$run_log_index" <<'PY'
import json, re, sys
summary, invocation, profile, action, output_format, backend, log_index = sys.argv[1:]
run_logs = []
try:
    with open(log_index, encoding="utf-8") as index:
        for entry in index.read().splitlines():
            number, _, relative = entry.partition("\t")
            if number.isdigit() and re.fullmatch(
                    r"MR_PET/pseudoct-run-\d{8}T\d{6}Z-[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\.log",
                    relative):
                run_logs.append({"subject": int(number), "path": relative})
except OSError:
    pass
values = open(summary, encoding="utf-8").read().splitlines()
if len(values) < 10:
    print("pseudoct: verified result summary is incomplete.", file=sys.stderr)
    raise SystemExit(69)
status, error_code, auth, submission, result_backend, science, dispatch, ids, result_action, message = values[:10]
error_code = "" if error_code == "-" else error_code
ids = "" if ids == "-" else ids
message = "" if message == "-" else message
job_ids = [int(v) for v in ids.split()] if ids else []
accepted = submission == "accepted"
if result_action == "validate":
    outcome = "validation_succeeded" if status == "ready" else "validation_failed"
elif error_code in {"AUTHENTICATION_FAILED", "NO_ACCOUNTS", "ACCOUNT_QUERY_FAILED", "CREDENTIAL_ERASE_FAILED", "CREDENTIAL_STORAGE_FAILED", "HOST_KEY_UNAVAILABLE", "INVALID_GROUP_ACCOUNT"}:
    outcome = "authentication_failed"
elif error_code in {"INVALID_REQUEST", "PROFILE_NOT_ALLOWED", "STALE_RESOLVED_JOB"}:
    outcome = "validation_failed"
elif science == "completed":
    outcome = "scientific_completed"
elif science == "failed":
    outcome = "scientific_failed"
elif result_backend == "local" and status == "failed":
    outcome = "scientific_failed"
elif accepted:
    outcome = "submission_accepted_completion_unverified"
elif submission in {"rejected", "unresolved"} or status == "failed":
    outcome = "submission_failed"
elif dispatch == "dispatched":
    outcome = "dispatch_returned_submission_unconfirmed"
else:
    outcome = "dispatch_not_attempted"
science_value = science if science in {"completed", "failed"} else None
science_reason = None if science_value is not None else (
    "Validation does not execute scientific processing." if action == "validate" else
    "The bound result reports scientific_completion=" + science + "; dispatch or scheduler acknowledgement is not completion evidence.")
record = {
    "type": "result", "invocation_id": invocation,
    "action": "validate" if action == "validate" else "submit",
    "profile": profile, "outcome": outcome,
    "headless_dispatch_returned": True,
    "dispatch_status": dispatch,
    "scheduler_submission_accepted": accepted,
    "submission_status": submission,
    "authentication_status": auth,
    "scientific_completion": science_value,
    "scientific_completion_status": science,
    "scientific_completion_reason": science_reason,
    "backend": result_backend, "job_ids": job_ids,
    "group_account": None if result_backend != "mlsc" else None,
    "group_account_reason": "Not exposed by the CLI result summary; inspect the bound MAT result.",
    "error_code": error_code or None,
    "error_message": message or None,
}

if result_action == "validate":
    code = 0 if status == "ready" else 65
elif error_code in {"AUTHENTICATION_FAILED", "NO_ACCOUNTS", "ACCOUNT_QUERY_FAILED", "CREDENTIAL_ERASE_FAILED", "CREDENTIAL_STORAGE_FAILED", "HOST_KEY_UNAVAILABLE", "INVALID_GROUP_ACCOUNT"}:
    code = 66
elif error_code in {"INVALID_REQUEST", "PROFILE_NOT_ALLOWED", "STALE_RESOLVED_JOB"}:
    code = 65
elif status == "submitted" and not error_code and science == "completed":
    code = 0
elif result_backend == "local" or science == "failed":
    code = 68
elif accepted:
    code = 68
elif submission in {"rejected", "unresolved"} or status == "failed" or error_code:
    code = 67
else:
    code = 69
