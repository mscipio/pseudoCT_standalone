#!/usr/bin/env bash
# pseudoct: the single public launcher for pseudoCT.
#
# Repository checkout (src/ present): the licensed MATLAB CLI, for development only.
# Installed distribution (no src/, runtimes/ required): compiled release selection
# and dispatch through the MATLAB Runtime of the selected release. An installed tree
# never runs the MATLAB CLI, and an incomplete one fails closed.
#
#   pseudoct run      [--mcr LABEL] [--mcr-root DIR] validate|run <CLI options>
#   pseudoct headless REQUEST.mat RESULT.mat [--mcr LABEL] [--mcr-root DIR]
#   pseudoct resolve  [--mcr LABEL] [--mcr-root DIR]
#   pseudoct --list-releases | --help
set -u

# Exit statuses listed in --help, including 70 for MATLAB dispatch or runtime failures.
EXIT_USAGE=64
EXIT_VALIDATION=65
EXIT_AUTH=66
EXIT_SUBMISSION=67
EXIT_SCIENCE=68
EXIT_RUNTIME=69
profiles='local local-mprage-only mlsc mlsc-mprage-only'
operation_phase=not_started

usage() {
    cat <<'USAGE'
Usage:
  pseudoct run      validate --profile PROFILE (--mprage FILE [--umap FILE] | --config job.json) [--mcr LABEL] [--mcr-root DIR] [options]
  pseudoct run      run      --profile PROFILE (--mprage FILE [--umap FILE] | --config job.json) [--mcr LABEL] [--mcr-root DIR] [options]
  pseudoct headless REQUEST.mat RESULT.mat [--mcr LABEL] [--mcr-root DIR]
  pseudoct resolve  [--mcr LABEL] [--mcr-root DIR]
  pseudoct --list-releases
  pseudoct --help

Operations:
  run validate|run    Validate a request, or validate and submit it (CLI options below).
  headless            Run one v2 headless request MAT into a result MAT.
  resolve             Validate one MATLAB Runtime and print sourceable PSEUDOCT_* lines.
  --list-releases     Print one line per installed release: label, MCR, default marker.

Release selection (installed distribution): --mcr LABEL selects the release (default:
the catalog default, R2010b). The MATLAB Runtime root is the catalog location
/usr/pubsw/common/matlab/<D> of that release, where D is the first two dotted components
of its matlab_version (9.6.0.1072779 -> 9.6), unless --mcr-root DIR names another
installation. The runtime identity is always validated against the catalog.

Options (run validate|run):
  --profile NAME                  Canonical supported profile (required)
  --mprage FILE --umap FILE       One subject; UMAP may be omitted for discovery
  --config job.json               Multi-subject JSON with mprage[] and optional umap[]
  --correct-aliasing yes|no       Override profile default
  --recenter-before-normalization yes|no
  --cleanup-on-success yes|no
  --current-artifact-root PATH    Development-only override; MLSC profiles only
  --group-account ACCOUNT        MLSC account selection for run
  --host-key-file FILE            Optional MLSC strict host-key input
  --credential-handoff FILE       Existing authorized single-use handoff
  --format text|jsonl             Output format (default: text)
  -h, --help                      Show this help

Exit codes: 0 validated/completed, 64 usage/config, 65 invalid request,
66 authentication, 67 submission failure, 68 scientific failure/unverified,
69 launcher/runtime failure, 70 MATLAB dispatch or runtime failure.
USAGE
}

# Fail with CODE: print MESSAGE to stderr and exit. With --format jsonl the failure is also
# written to stdout as one result record; an empty error_class (third argument) defaults from CODE.
error_record() {
    code=$1
    message=$2
    error_class=${3:-}
    if [ -z "$error_class" ]; then
        case "$code" in
            64) error_class=USAGE_OR_CONFIG_ERROR ;;
            65) error_class=INVALID_REQUEST ;;
            66) error_class=AUTHENTICATION_FAILED ;;
            67) error_class=SUBMISSION_FAILED ;;
            68) error_class=SCIENTIFIC_FAILURE_OR_UNVERIFIED ;;
            *) error_class=CLI_RUNTIME_ERROR ;;
        esac
    fi
    if [ "${format:-text}" = jsonl ]; then
        python3 - "${invocation_id:-}" "${action:-unknown}" \
            "${profile:-}" "$error_class" "$message" "$code" \
            "$operation_phase" <<'PY'
import json, sys
invocation, action, profile, error_code, message, exit_code, phase = sys.argv[1:]
unknown_submit = phase == "submit_called"
unknown_reason = "unknown: submit outcome not established"
record = {
    "type": "result", "invocation_id": invocation or None,
    "action": action, "profile": profile or None, "outcome": "failed",
    "exit_code": int(exit_code),
    "headless_dispatch_returned": True if unknown_submit else False,
    "dispatch_status": None if unknown_submit else "not_dispatched",
    "submission_status": None if unknown_submit else "not_attempted",
    "scheduler_submission_accepted": None if unknown_submit else False,
    "scientific_completion": None,
    "scientific_completion_reason": "No verified scientific result is available because the CLI operation stopped before completion.",
    "job_ids": [], "error_code": error_code, "error_message": message,
}
if unknown_submit:
    record["dispatch_status_reason"] = unknown_reason
    record["submission_status_reason"] = unknown_reason
    record["scheduler_submission_accepted_reason"] = unknown_reason
print(json.dumps(record, separators=(",", ":")))
PY
    fi
    printf 'pseudoct: %s\n' "$message" >&2
    exit "$code"
}


# Print MESSAGE to stderr and exit with CODE, without a result record.
fail_op() {
    printf 'pseudoct: %s\n' "$1" >&2
    exit "$2"
}

# Locate this launcher through PATH and symlinks; the package root is the parent of the
# real directory of bin/pseudoct, never the caller's directory.
case "$0" in
    */*) self_path=$0 ;;
    *) self_path=$(command -v "$0") || fail_op 'cannot locate the launcher' 69 ;;
esac
self_path=$(readlink -f -- "$self_path") || fail_op 'cannot resolve the launcher path' 69
bin_dir=$(CDPATH= cd -P -- "$(dirname -- "$self_path")" && pwd -P) ||
    fail_op 'cannot resolve the launcher directory' 69
root_dir=$(CDPATH= cd -P -- "$bin_dir/.." && pwd -P) ||
    fail_op 'cannot resolve the installation root' 69
self=$bin_dir/$(basename -- "$self_path")
# The installed layout is the tree without src/. It must carry runtimes/; a missing
# runtimes/ is an incomplete installation that fails closed, never a source checkout.
installed=0
if [ ! -e "$root_dir/src" ]; then
    installed=1
    if [ ! -d "$root_dir/runtimes" ]; then
        fail_op 'this pseudoCT installation is incomplete (runtimes/ is missing); reinstall the pseudoCT distribution' "$EXIT_RUNTIME"
    fi
fi
if [ "$installed" -eq 1 ]; then
    catalog=$root_dir/manifest.json
    catalog_key=catalog
    catalog_mode=installed
else
    catalog=$root_dir/config/releases.json
    catalog_key=''
    catalog_mode=catalog
fi

# Parent of the catalog MATLAB Runtime locations <base>/<D>, where D is the first two dotted
# components of a release's matlab_version (9.6.0.1072779 -> 9.6, 7.11 -> 7.11). Fixed.
catalog_mcr_base=/usr/pubsw/common/matlab

# Artifacts every installed release must provide (kept in step with the driver).
RELEASE_ARTIFACTS='pseudoct_worker run_pseudoct_worker.sh pseudoct_standalone'

# Catalog reader: list | default | resolve LABEL. Installed mode lists complete releases only.
CATALOG_PY='
import json, os, re, shlex, sys
path, key, command, label, root, mode = sys.argv[1:7]
REQUIRED = ["pseudoct_worker",
            "run_pseudoct_worker.sh", "pseudoct_standalone"]
def fail(message, code):
    sys.stderr.write("pseudoct: " + message + "\n")
    sys.exit(code)
def complete(name):
    return all(os.path.isfile(os.path.join(root, "runtimes", name, *rel.split("/")))
               for rel in REQUIRED)
try:
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, ValueError) as exc:
    fail("release catalog is unavailable: %s" % exc, 69)
if key:
    data = data.get(key) if isinstance(data, dict) else None
if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("releases"), list):
    fail("release catalog is invalid", 69)
entries = data["releases"]
default = data.get("default")
labels = []
for entry in entries:
    ident = entry.get("runtime_identity") if isinstance(entry, dict) else None
    ok = (isinstance(entry, dict) and isinstance(entry.get("label"), str)
          and re.fullmatch(r"R[0-9]{4}[ab]", entry["label"])
          and all(isinstance(entry.get(k), str) and entry.get(k) for k in ("matlab_version", "mcr_version", "architecture"))
          and isinstance(ident, dict) and isinstance(ident.get("mcr_version_file"), str)
          and isinstance(ident.get("library"), str)
          and ident["library"] == "libmwmclmcrrt.so." + entry["mcr_version"])
    if not ok:
        fail("release catalog contains an invalid entry", 69)
    labels.append(entry["label"])
if len(set(labels)) != len(labels) or default not in labels:
    fail("release catalog has duplicate labels or an invalid default", 69)
if command == "list":
    for entry in entries:
        if mode == "installed" and not complete(entry["label"]):
            continue
        print("%s\t%s\t%s" % (entry["label"], entry["mcr_version"],
                              "default" if entry["label"] == default else "-"))
elif command == "default":
    print(default)
else:
    match = [entry for entry in entries if entry["label"] == label]
    if not label or not match:
        fail("unknown or missing release label %r; supported: %s"
             % (label, ", ".join(labels)), 2)
    entry = match[0]
    print("CAT_MATLAB_VERSION=" + shlex.quote(entry["matlab_version"]))
    print("CAT_MCR_VERSION=" + shlex.quote(entry["mcr_version"]))
    print("CAT_ARCH=" + shlex.quote(entry["architecture"]))
    print("CAT_VERSION_FILE=" + shlex.quote(entry["runtime_identity"]["mcr_version_file"]))
    print("CAT_LIBRARY=" + shlex.quote(entry["runtime_identity"]["library"]))
    dirname = re.fullmatch(r"([0-9]+)\.([0-9]+)(\.[0-9]+)*", entry["matlab_version"])
    print("CAT_MCR_DIR=" + shlex.quote(dirname.group(1) + "." + dirname.group(2) if dirname else ""))
'

catalog_query() {
    python3 -I -B -c "$CATALOG_PY" "$catalog" "$catalog_key" "$1" "${2-}" "$root_dir" "$catalog_mode"
}

# Single-quote a value for sourcing: embedded quotes become '\''.
quoted() {
    q=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
    printf "'%s'" "$q"
}

# Usage check: called as need_value OPTION "$@"; fails unless a value follows the option.
need_value() {
    [ "$#" -ge 2 ] || error_record "$EXIT_USAGE" "An option is missing its value."
}

list_releases() {
    catalog_query list '' || exit $?
    exit 0
}

require_installed() {
    [ "$installed" -eq 1 ] ||
        fail_op "$1 requires an installed pseudoCT distribution (runtimes/ beside bin/)" "$EXIT_USAGE"
}

# Shared selection: LABEL HAVE_ROOT ROOT_ARG RELATIVE_EXECUTABLE. Sets SEL_RELEASE, SEL_EXE,
# SEL_RUNNER, SEL_MCR_ROOT and SEL_LD_PATH, or SEL_ERROR (message for the caller). Returns 64
# (unknown label or bad root option) or 69 (incomplete release, unsupported architecture,
# missing or mismatched MATLAB Runtime). The runtime identity (library and mcrversion.ver)
# is always checked against the catalog.
select_release() {
    sel_label=$1
    sel_have_root=$2
    sel_root_arg=$3
    sel_rel=$4
    SEL_ERROR=''
    rc=0
    fields=$(catalog_query resolve "$sel_label") || rc=$?
    if [ "$rc" -ne 0 ]; then
        [ "$rc" -eq 2 ] && return "$EXIT_USAGE"
        return "$EXIT_RUNTIME"
    fi
    eval "$fields"
    [ "$CAT_ARCH" = glnxa64 ] || { SEL_ERROR="unsupported architecture $CAT_ARCH"; return "$EXIT_RUNTIME"; }
    release_dir=$root_dir/runtimes/$sel_label
    for artifact in $RELEASE_ARTIFACTS; do
        if [ ! -f "$release_dir/$artifact" ] || [ ! -x "$release_dir/$artifact" ]; then
            SEL_ERROR="$sel_label is incomplete in this distribution (missing $artifact)"
            return "$EXIT_RUNTIME"
        fi
    done
    # Root: --mcr-root when given, else the catalog location <base>/<D> of this release
    # (D: first two dotted components of matlab_version). No environment variable takes
    # part in discovery; the candidate is always identity-validated below.
    if [ "$sel_have_root" -eq 1 ]; then
        [ -n "$sel_root_arg" ] || { SEL_ERROR='--mcr-root requires a directory'; return "$EXIT_USAGE"; }
        selected=$sel_root_arg
        where='(--mcr-root)'
    else
        case "$CAT_MCR_DIR" in
            ''|*/*|.|..) SEL_ERROR="$sel_label: matlab_version $CAT_MATLAB_VERSION does not name a runtime directory; pass --mcr-root DIR"; return "$EXIT_RUNTIME" ;;
        esac
        selected=$catalog_mcr_base/$CAT_MCR_DIR
        where="(catalog location for matlab_version $CAT_MATLAB_VERSION; pass --mcr-root DIR to select another installation)"
        [ -d "$selected" ] ||
            { SEL_ERROR="no MATLAB Runtime root for $sel_label: the catalog location $selected is not a directory; pass --mcr-root DIR to select another installation"; return "$EXIT_RUNTIME"; }
    fi
    mcr_abs=$(CDPATH= cd -P -- "$selected" 2>/dev/null && pwd -P) ||
        { SEL_ERROR="MATLAB Runtime root is not a directory: $selected $where"; return "$EXIT_RUNTIME"; }
    library=$mcr_abs/runtime/$CAT_ARCH/$CAT_LIBRARY
    [ -f "$library" ] ||
        { SEL_ERROR="$sel_label: runtime library $CAT_LIBRARY not found under $mcr_abs $where"; return "$EXIT_RUNTIME"; }
    version_file=$mcr_abs/$CAT_VERSION_FILE
    [ -f "$version_file" ] ||
        { SEL_ERROR="$sel_label: $CAT_VERSION_FILE not found under $mcr_abs $where"; return "$EXIT_RUNTIME"; }
    found=$(head -n 1 "$version_file" | tr -d '\r' | sed 's/[[:space:]]*$//')
    [ "$found" = "$CAT_MCR_VERSION" ] ||
        { SEL_ERROR="MATLAB Runtime at $mcr_abs $where reports MCR '$found'; $sel_label requires '$CAT_MCR_VERSION'"; return "$EXIT_RUNTIME"; }
    SEL_RELEASE=$sel_label
    SEL_EXE=$release_dir/$sel_rel
    SEL_RUNNER=$release_dir/run_pseudoct_worker.sh
    SEL_MCR_ROOT=$mcr_abs
    SEL_LD_PATH=$mcr_abs/runtime/glnxa64:$mcr_abs/bin/glnxa64:$mcr_abs/sys/os/glnxa64
    # MCR 7.14 libjvm.so lives under sys/java/.../amd64/server: add the Runtime's Java
    # directories only when present (the compiled engines do not use -nojvm).
    for jre_dir in "$mcr_abs/sys/java/jre/glnxa64/jre/lib/amd64" "$mcr_abs/sys/java/jre/glnxa64/jre/lib/amd64/server"; do
        if [ -d "$jre_dir" ]; then SEL_LD_PATH=$SEL_LD_PATH:$jre_dir; fi
    done
    return 0
}

release_fail() {
    [ -z "${SEL_ERROR:-}" ] || printf 'pseudoct: %s\n' "$SEL_ERROR" >&2
    exit "$1"
}

# Environment every compiled release inherits: the installation root and the resolved
# release label, so the dispatcher binds the selected release and not the catalog default.
export_release_env() {
    PSEUDOCT_INSTALL_ROOT=$root_dir
    PSEUDOCT_RUNTIME_RELEASE=$SEL_RELEASE
    PSEUDOCT_RUNTIME_MCR_ROOT=$SEL_MCR_ROOT
    export PSEUDOCT_INSTALL_ROOT PSEUDOCT_RUNTIME_RELEASE PSEUDOCT_RUNTIME_MCR_ROOT
}

# Leading/shared selection options anywhere in the arguments; everything else is kept
# in REST_ARGS in order.
parse_selection() {
    SEL_OPT_LABEL=''
    SEL_OPT_HAVE_LABEL=0
    SEL_OPT_ROOT=''
    SEL_OPT_HAVE_ROOT=0
    REST_ARGS=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --mcr)
                [ "$#" -ge 2 ] && [ "$SEL_OPT_HAVE_LABEL" -eq 0 ] ||
                    fail_op 'option --mcr needs exactly one release label' "$EXIT_USAGE"
                SEL_OPT_LABEL=$2; SEL_OPT_HAVE_LABEL=1; shift 2 ;;
            --mcr=*)
                [ "$SEL_OPT_HAVE_LABEL" -eq 0 ] || fail_op 'specify --mcr only once' "$EXIT_USAGE"
                SEL_OPT_LABEL=${1#*=}; SEL_OPT_HAVE_LABEL=1; shift ;;
            --mcr-root)
                [ "$#" -ge 2 ] && [ "$SEL_OPT_HAVE_ROOT" -eq 0 ] ||
                    fail_op 'option --mcr-root needs exactly one directory' "$EXIT_USAGE"
                SEL_OPT_ROOT=$2; SEL_OPT_HAVE_ROOT=1; shift 2 ;;
            --mcr-root=*)
                [ "$SEL_OPT_HAVE_ROOT" -eq 0 ] || fail_op 'specify --mcr-root only once' "$EXIT_USAGE"
                SEL_OPT_ROOT=${1#*=}; SEL_OPT_HAVE_ROOT=1; shift ;;
            *)
                REST_ARGS+=("$1"); shift ;;
        esac
    done
    if [ "$SEL_OPT_HAVE_ROOT" -eq 1 ]; then
        [ -n "$SEL_OPT_ROOT" ] || fail_op '--mcr-root requires a directory' "$EXIT_USAGE"
        case "$SEL_OPT_ROOT" in /*) ;; *) SEL_OPT_ROOT=$PWD/$SEL_OPT_ROOT ;; esac
    fi
}

# Label of the selection: explicit --mcr, else the catalog default.
selection_label() {
    if [ "$SEL_OPT_HAVE_LABEL" -eq 1 ]; then
        SEL_LABEL=$SEL_OPT_LABEL
    else
        SEL_LABEL=$(catalog_query default '') || fail_op 'cannot read the default release' "$EXIT_RUNTIME"
    fi
}

# resolve: print sourceable PSEUDOCT_* lines for the selected installed release.
op_resolve() {
    parse_selection "$@"
    [ "${#REST_ARGS[@]}" -eq 0 ] || fail_op 'resolve takes only --mcr and --mcr-root' "$EXIT_USAGE"
    require_installed resolve
    selection_label
    select_release "$SEL_LABEL" "$SEL_OPT_HAVE_ROOT" "$SEL_OPT_ROOT" pseudoct_standalone ||
        release_fail $?
    printf 'PSEUDOCT_EXE=%s\n' "$(quoted "$SEL_EXE")"
    printf 'PSEUDOCT_MCR_ROOT=%s\n' "$(quoted "$SEL_MCR_ROOT")"
    printf 'PSEUDOCT_RUNNER=%s\n' "$(quoted "$SEL_RUNNER")"
    printf 'PSEUDOCT_INSTALL_ROOT=%s\n' "$(quoted "$root_dir")"
    printf 'PSEUDOCT_RUNTIME_RELEASE=%s\n' "$(quoted "$SEL_RELEASE")"
    printf 'PSEUDOCT_RUNTIME_MCR_ROOT=%s\n' "$(quoted "$SEL_MCR_ROOT")"
    exit 0
}

# headless REQUEST.mat RESULT.mat: check the request and result paths, select the release
# (installed) or the MATLAB bootstrap (repository), and run one headless request.
op_headless() {
    parse_selection "$@"
    [ "${#REST_ARGS[@]}" -eq 2 ] ||
        fail_op 'usage: pseudoct headless REQUEST.mat RESULT.mat [--mcr LABEL] [--mcr-root DIR]' "$EXIT_USAGE"
    request_input=${REST_ARGS[0]}
    result_input=${REST_ARGS[1]}
    if [ "$installed" -eq 0 ] && { [ "$SEL_OPT_HAVE_LABEL" -eq 1 ] || [ "$SEL_OPT_HAVE_ROOT" -eq 1 ]; }; then
        fail_op '--mcr and --mcr-root are available only in an installed standalone distribution' "$EXIT_USAGE"
    fi
    newline='
'
    case "$request_input" in
        *"$newline"*) fail_op 'request path cannot contain a newline' 65 ;;
    esac
    case "$result_input" in
        *"$newline"*) fail_op 'result path cannot contain a newline' 66 ;;
    esac
    request_path=$(readlink -f -- "$request_input") ||
        fail_op 'request MAT file is unavailable or unreadable' 65
    [ -f "$request_path" ] && [ -r "$request_path" ] ||
        fail_op 'request MAT file is unavailable or unreadable' 65
    # -m canonicalizes a not-yet-created output and resolves existing parent and target
    # symlinks, allowing reliable same-file checks without creating files.
    result_path=$(readlink -m -- "$result_input") || fail_op 'result path is invalid' 66
    [ -n "$result_path" ] && [ ! -d "$result_path" ] || fail_op 'result path must name a file' 66
    result_parent=$(dirname -- "$result_path")
    [ -d "$result_parent" ] && [ -w "$result_parent" ] && [ -x "$result_parent" ] ||
        fail_op 'result parent is not a writable directory' 66
    if [ -e "$result_path" ] && [ ! -w "$result_path" ]; then
        fail_op 'existing result file is not writable' 66
    fi
    [ "$request_path" != "$result_path" ] || fail_op 'request and result paths must differ' 66

    if [ "$installed" -eq 1 ]; then
        selection_label
        select_release "$SEL_LABEL" "$SEL_OPT_HAVE_ROOT" "$SEL_OPT_ROOT" pseudoct_standalone ||
            release_fail $?
        standalone_exe=$SEL_EXE
        mcr_ld_path=$SEL_LD_PATH
        export_release_env
    else
        unset PSEUDOCT_RUNTIME_RELEASE
        matlab_bin=${PSEUDOCT_MATLAB:-/usr/pubsw/common/matlab/7.11/bin/matlab}
        case "$matlab_bin" in
            */*) ;;
            *) matlab_bin=$(command -v "$matlab_bin") ||
                fail_op 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' "$EXIT_RUNTIME" ;;
        esac
        matlab_bin=$(readlink -f -- "$matlab_bin") ||
            fail_op 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' "$EXIT_RUNTIME"
        [ -x "$matlab_bin" ] ||
            fail_op 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path' "$EXIT_RUNTIME"
        [ -f "$root_dir/src/cli/pseudoct_headless_cli_r2010b.m" ] ||
            fail_op 'versioned MATLAB bootstrap is unavailable' 70
    fi

    # Only request/result paths are added to the MATLAB environment. Credentials
    # remain in the external one-use MAT handoff referenced by the request.
    PSEUDOCT_REQUEST_MAT=$request_path
    PSEUDOCT_RESULT_MAT=$result_path
    export PSEUDOCT_REQUEST_MAT PSEUDOCT_RESULT_MAT
    case "$result_parent/" in
        */MR_PET/tmp/*) ;;
        *) fail_op 'runtime directory must be under the resolved subject MR_PET/tmp' 70 ;;
    esac
    runtime_dir=$(umask 077; mktemp -d "$result_parent/pseudoct-headless.XXXXXXXX") ||
        fail_op 'subject runtime directory unavailable' 70
    chmod 00700 "$runtime_dir" || fail_op 'cannot secure subject runtime directory' 70
    trap 'rm -rf -- "$runtime_dir"' 0
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    export PSEUDOCT_INSTALL_ROOT="$root_dir"
    export TMPDIR="$runtime_dir" TMP="$runtime_dir" TEMP="$runtime_dir"
    export MATLAB_PREFDIR="$runtime_dir/matlab-prefs" MCR_CACHE_ROOT="$runtime_dir/mcr-cache"
    cd -P -- "$runtime_dir" || fail_op 'cannot enter subject runtime directory' 70

    if [ "$installed" -eq 1 ]; then
        LD_LIBRARY_PATH=$mcr_ld_path "$standalone_exe" headless
    else
        # Keep this fixed: no paths or request values are interpolated into MATLAB
        # source or command-line expressions. The bootstrap keeps the JVM enabled.
        "$matlab_bin" -nodesktop -nosplash -nodisplay <<'MATLAB'
try
    addpath(fullfile(getenv('PSEUDOCT_INSTALL_ROOT'), 'src', 'cli'), '-begin');
    pseudoct_headless_cli_r2010b;
catch
    status = 70;
end
if ~exist('status', 'var') || ~isnumeric(status) || ...
        ~isscalar(status) || ~isfinite(status) || status ~= fix(status) || ...
        status < 0 || status > 255
    status = 70;
end
exit(status);
MATLAB
    fi
    matlab_status=$?

    case "$matlab_status" in
        0|2|3)
            [ -f "$result_path" ] && [ -s "$result_path" ] ||
                fail_op 'MATLAB returned without a usable result MAT file' 70
            ;;
    esac
    case "$matlab_status" in
        0|2|3) exit "$matlab_status" ;;
        70)
            printf 'pseudoct: MATLAB dispatch/runtime failure\n' >&2
            exit 70 ;;
        *)
            printf 'pseudoct: MATLAB startup failed or exited unexpectedly\n' >&2
            exit 70 ;;
    esac
}

# run validate|run: validate the job and, for run, submit the validated result. Remote
# profiles need a terminal prompt or a --credential-handoff for the submit phase.
op_run() {
    parse_selection "$@"
    set -- ${REST_ARGS[@]+"${REST_ARGS[@]}"}
    if [ "$#" -lt 1 ]; then
        usage >&2
        exit "$EXIT_USAGE"
    fi
    action=$1
    shift
    case "$action" in
        validate|run) ;;
        *) fail_op 'run takes validate or run; see --help' "$EXIT_USAGE" ;;
    esac

    profile=''
    mprage=''
    umap=''
    config=''
    correct_aliasing=''
    recenter=''
    cleanup_success=''
    artifact_root=''
    group_account=''
    host_key_file=''
    credential_handoff=''
    format=text
    seen_mprage=0
    seen_umap=0
    seen_config=0

    while [ "$#" -gt 0 ]; do
        option=$1
        shift
        case "$option" in
            --profile|--mprage|--umap|--config|--correct-aliasing|\
            --recenter-before-normalization|--cleanup-on-success|\
            --current-artifact-root|--group-account|--host-key-file|\
            --credential-handoff|--format)
                need_value "$option" "$@"
                value=$1
                shift
                ;;
            --profile=*) value=${option#*=}; option=--profile ;;
            --mprage=*) value=${option#*=}; option=--mprage ;;
            --umap=*) value=${option#*=}; option=--umap ;;
            --config=*) value=${option#*=}; option=--config ;;
            --correct-aliasing=*) value=${option#*=}; option=--correct-aliasing ;;
            --recenter-before-normalization=*) value=${option#*=}; option=--recenter-before-normalization ;;
            --cleanup-on-success=*) value=${option#*=}; option=--cleanup-on-success ;;
            --current-artifact-root=*) value=${option#*=}; option=--current-artifact-root ;;
            --group-account=*) value=${option#*=}; option=--group-account ;;
            --host-key-file=*) value=${option#*=}; option=--host-key-file ;;
            --credential-handoff=*) value=${option#*=}; option=--credential-handoff ;;
            --format=*) value=${option#*=}; option=--format ;;
            -h|--help) usage; exit 0 ;;
            *) error_record "$EXIT_USAGE" "Unknown option: $option" ;;
        esac
        case "$option" in
            --profile) [ -z "$profile" ] || error_record "$EXIT_USAGE" 'Specify --profile only once.'; profile=$value ;;
            --mprage) [ "$seen_mprage" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --mprage only once.'; mprage=$value; seen_mprage=1 ;;
            --umap) [ "$seen_umap" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --umap only once.'; umap=$value; seen_umap=1 ;;
            --config) [ "$seen_config" -eq 0 ] || error_record "$EXIT_USAGE" 'Specify --config only once.'; config=$value; seen_config=1 ;;
            --correct-aliasing) correct_aliasing=$value ;;
            --recenter-before-normalization) recenter=$value ;;
            --cleanup-on-success) cleanup_success=$value ;;
            --current-artifact-root) artifact_root=$value ;;
            --group-account) group_account=$value ;;
            --host-key-file) host_key_file=$value ;;
            --credential-handoff) credential_handoff=$value ;;
            --format) format=$value ;;
        esac
    done

    case " $profiles " in *" $profile "*) ;; *) error_record "$EXIT_USAGE" 'A supported --profile is required.' ;; esac
    case "$format" in text|jsonl) ;; *) error_record "$EXIT_USAGE" '--format must be text or jsonl.' ;; esac
    if [ "$seen_config" -eq 1 ]; then
        [ "$seen_mprage" -eq 0 ] && [ "$seen_umap" -eq 0 ] || \
            error_record "$EXIT_USAGE" 'Use either --config or single-subject --mprage/--umap flags.'
        [ -f "$config" ] && [ -r "$config" ] || \
            error_record "$EXIT_USAGE" 'The job configuration file is unavailable.'
    else
        [ "$seen_mprage" -eq 1 ] || error_record "$EXIT_USAGE" 'Specify --mprage or --config.'
    fi
    for flag_value in "$correct_aliasing" "$recenter" "$cleanup_success"; do
        case "$flag_value" in ''|yes|no) ;; *) error_record "$EXIT_USAGE" 'Processing options accept only yes or no.' ;; esac
    done
    case "$profile" in
        local|local-mprage-only) backend=local ;;
        mlsc|mlsc-mprage-only) backend=mlsc ;;
    esac
    case "$profile" in *mprage-only*) mprage_only=1 ;; *) mprage_only=0 ;; esac
    if [ "$mprage_only" -eq 1 ] && [ "$seen_umap" -eq 1 ]; then
        error_record "$EXIT_USAGE" 'MPRAGE-only profiles do not accept --umap.'
    fi
    if [ -n "$artifact_root" ]; then
        case "$profile" in mlsc|mlsc-mprage-only) ;; *) error_record "$EXIT_USAGE" '--current-artifact-root is a development-only override accepted only for the mlsc and mlsc-mprage-only profiles.' ;; esac
    fi
    if [ -n "$group_account" ] && [ "$backend" != mlsc ]; then
        error_record "$EXIT_USAGE" '--group-account is available only for MLSC profiles.'
    fi
    if [ -n "$host_key_file" ] && [ "$backend" != mlsc ]; then
        error_record "$EXIT_USAGE" '--host-key-file is available only for MLSC profiles.'
    fi
    if [ -n "$credential_handoff" ] && { [ "$action" != run ] || [ "$backend" = local ]; }; then
        error_record "$EXIT_USAGE" '--credential-handoff is valid only for remote run.'
    fi
    case "$group_account$artifact_root$host_key_file$credential_handoff" in *$'\n'*|*$'\r'*) error_record "$EXIT_USAGE" 'CLI text values cannot contain line breaks.' ;; esac
    if [ -n "$credential_handoff" ]; then
        credential_handoff=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$credential_handoff") || \
            error_record "$EXIT_USAGE" 'Credential handoff path is invalid.'
    fi

    # Release selection. A repository checkout has no release selection and is refused
    # the selection options; an installed distribution selects one compiled release.
    headless_args=(headless)
    if [ "$installed" -eq 0 ]; then
        if [ "$SEL_OPT_HAVE_LABEL" -eq 1 ] || [ "$SEL_OPT_HAVE_ROOT" -eq 1 ]; then
            error_record "$EXIT_USAGE" '--mcr and --mcr-root are available only in an installed standalone distribution.'
        fi
        unset PSEUDOCT_RUNTIME_RELEASE
    else
        selection_label
        rc=0
        select_release "$SEL_LABEL" "$SEL_OPT_HAVE_ROOT" "$SEL_OPT_ROOT" pseudoct_standalone || rc=$?
        if [ "$rc" -ne 0 ]; then
            error_record "$rc" "${SEL_ERROR:-The selected MATLAB Runtime is unavailable or does not match its release.}"
        fi
        standalone_exe=$SEL_EXE
        mcr_ld_path=$SEL_LD_PATH
        export_release_env
        headless_args=(headless --mcr "$SEL_RELEASE")
        if [ "$SEL_OPT_HAVE_ROOT" -eq 1 ]; then
            headless_args+=(--mcr-root "$SEL_OPT_ROOT")
        fi
    fi

# Resolve the request's owning subject before creating ANY runtime files.
# A multi-subject request's CLI transport belongs to its first subject;
# scientific runners still allocate beneath each individual job.temp_dir.
umask 077
subject_temp=$(python3 - "$config" "$mprage" "$seen_config" <<'PY'
import json, os, sys
try:
    if sys.argv[3] == '1':
        with open(sys.argv[1], encoding='utf-8') as f:
            job = json.load(f)
        paths = job['mprage']
        if not isinstance(paths, list) or not paths:
            raise ValueError()
        value = paths[0]
    else:
        value = sys.argv[2]
    if not isinstance(value, str) or not value or any(c in value for c in '\0\r\n'):
        raise ValueError()
    path = os.path.abspath(os.path.expanduser(value))
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        raise ValueError()
    series = os.path.dirname(path)
    search = series
    processing_root = ''
    while os.path.basename(search).lower() != 'mr':
        if not processing_root and os.path.basename(search).lower() == 'mr_pet':
            processing_root = search
        parent = os.path.dirname(search)
        if parent == search:
            search = ''
            break
        search = parent
    subject = os.path.dirname(search) if search else (
        os.path.dirname(processing_root) if processing_root else os.path.dirname(series))
    target = os.path.join(subject, 'MR_PET', 'tmp')
    if os.path.islink(target):
        raise ValueError()
    os.makedirs(target, mode=0o700, exist_ok=True)
    print(target)
except (OSError, ValueError, TypeError, KeyError):
    raise SystemExit(1)
PY
) || error_record "$EXIT_RUNTIME" 'Cannot resolve a writable subject MR_PET/tmp directory.'
umask 077
tmp_dir=$(mktemp -d "$subject_temp/pseudoct-cli.XXXXXXXX" 2>/dev/null) || \
    error_record "$EXIT_RUNTIME" 'Cannot create a private temporary directory.'
chmod 00700 "$tmp_dir" || error_record "$EXIT_RUNTIME" 'Cannot secure the temporary directory.'
secret_dir=''
handoff_registry=$tmp_dir/handoff-path.txt
tty_state=''
cleanup() {
    if [ -n "$tty_state" ] && [ -r /dev/tty ]; then
        stty "$tty_state" < /dev/tty 2>/dev/null || true
    fi
    if [ -n "$secret_dir" ] && [ -d "$secret_dir" ]; then
        python3 - "$secret_dir/login" <<'PY' >/dev/null 2>&1 || true
import os, sys
path = sys.argv[1]
try:
    with open(path, "r+b", buffering=0) as f:
        size = os.fstat(f.fileno()).st_size
        f.write(b"\0" * size)
    os.unlink(path)
except OSError:
    pass
try:
    os.rmdir(os.path.dirname(path))
except OSError:
    pass
PY
    fi
    if [ -n "$handoff_registry" ] && [ -f "$handoff_registry" ]; then
        python3 - "$handoff_registry" <<'PY' >/dev/null 2>&1 || true
import os, re, stat, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as registry:
        path = registry.readline().rstrip("\n")
    if not re.fullmatch(r"/dev/shm/pseudo_CT_credentials_[A-Za-z0-9_.-]+/credentials\.mat", path):
        raise OSError("invalid private handoff path")
    directory = os.path.dirname(path)
    directory_info = os.lstat(directory)
    if not stat.S_ISDIR(directory_info.st_mode) or directory_info.st_mode & 0o077:
        raise OSError("unsafe private handoff directory")
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
        raise OSError("unsafe private handoff file")
    fd = os.open(path, os.O_WRONLY | os.O_NOFOLLOW)
    try:
        remaining = os.fstat(fd).st_size
        while remaining:
            count = os.write(fd, b"\0" * min(remaining, 4096))
            if count <= 0:
                raise OSError("handoff overwrite failed")
            remaining -= count
    finally:
        os.close(fd)
    os.unlink(path)
    os.rmdir(directory)
except OSError:
    pass
PY
    fi
    if [ -n "${tmp_dir:-}" ] && [ -d "$tmp_dir" ]; then
        rm -rf -- "$tmp_dir"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# MATLAB/MCR caches, crash diagnostics and Python subprocess temporaries must
# share the resolved subject location, never the installation or system temp.
export TMPDIR="$tmp_dir" TMP="$tmp_dir" TEMP="$tmp_dir"
export MATLAB_PREFDIR="$tmp_dir/matlab-prefs" MCR_CACHE_ROOT="$tmp_dir/mcr-cache"
export PSEUDOCT_RUNTIME_DIR="$tmp_dir"

invocation_id=$(uuidgen | tr 'A-F' 'a-f') || error_record "$EXIT_RUNTIME" 'Cannot generate an invocation UUID.'
# Private index of relative MR_PET run-log paths reported by the lifecycle.
# Only this scratch index is removed by cleanup(); the subject's persistent
# pseudoct-run-*.log files are never deleted by the CLI.
run_log_index=$tmp_dir/run-logs.txt
: > "$run_log_index" || error_record "$EXIT_RUNTIME" 'Cannot create the private run-log index.'
input_file=$tmp_dir/cli-input.txt
validate_request=$tmp_dir/validate-request.mat
validate_result=$tmp_dir/validate-result.mat
submit_request=$tmp_dir/submit-request.mat
submit_result=$tmp_dir/submit-result.mat
summary_file=$tmp_dir/result-summary.txt

if ! python3 - "$input_file" "$profile" "$invocation_id" "$config" \
    "$mprage" "$umap" "$seen_config" "$seen_umap" "$correct_aliasing" \
    "$recenter" "$cleanup_success" "$artifact_root" "$group_account" \
    "$host_key_file" <<'PY'
import json, os, sys
output, profile, invocation, config_path, mprage, umap, has_config, has_umap, aliasing, recenter, cleanup, artifact_root, account, host_key = sys.argv[1:]

def fail(message):
    print("pseudoct: " + message, file=sys.stderr)
    raise SystemExit(64)

def one_line(value, label):
    if not isinstance(value, str) or not value or any(c in value for c in "\0\r\n"):
        fail(label + " must be non-empty text without line breaks.")
    return os.path.abspath(os.path.expanduser(value))

if has_config == "1":
    try:
        with open(config_path, "r", encoding="utf-8") as f:
            job = json.load(f)
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("job configuration is not readable valid JSON.")
    if not isinstance(job, dict) or set(job) - {"mprage", "umap"} or "mprage" not in job:
        fail("job JSON must contain mprage[] and optional umap[] only.")
    mprages = job["mprage"]
    umaps = job.get("umap")
    if not isinstance(mprages, list) or not mprages:
        fail("job JSON mprage must be a non-empty array of paths.")
    if umaps is not None and (not isinstance(umaps, list) or len(umaps) != len(mprages)):
        fail("job JSON umap must be an array positionally paired with mprage.")
    mprages = [one_line(v, "MPRAGE path") for v in mprages]
    if umaps is not None:
        umaps = [one_line(v, "UMAP path") for v in umaps]
else:
    mprages = [one_line(mprage, "MPRAGE path")]
    umaps = [one_line(umap, "UMAP path")] if has_umap == "1" else None

if "mprage-only" in profile and umaps is not None:
    fail("MPRAGE-only profiles do not accept UMAP paths.")
if "mprage-only" not in profile and umaps is not None and len(umaps) != len(mprages):
    fail("UMAP paths must be positionally paired with MPRAGE paths.")
if artifact_root:
    artifact_root = one_line(artifact_root, "Current artifact root")
if host_key:
    host_key = one_line(host_key, "Host-key file")
values = [profile, invocation, str(len(mprages)), "1" if umaps is not None else "0"]
values.extend(mprages)
if umaps is not None:
    values.extend(umaps)
values.extend(["1" if aliasing == "yes" else "0" if aliasing == "no" else "",
               "1" if recenter == "yes" else "0" if recenter == "no" else "",
               "1" if cleanup == "yes" else "0" if cleanup == "no" else "",
               artifact_root, account, host_key])
with open(output, "x", encoding="utf-8", newline="\n") as f:
    f.write("\n".join(values) + "\n")
os.chmod(output, 0o600)
PY
then
    error_record "$EXIT_USAGE" 'Job configuration or input paths are invalid.'
fi

if [ "$installed" -eq 0 ]; then
matlab_bin=${PSEUDOCT_MATLAB:-/usr/pubsw/common/matlab/7.11/bin/matlab}
if [ ! -x "$matlab_bin" ]; then
    if command -v "$matlab_bin" >/dev/null 2>&1; then
        matlab_bin=$(command -v "$matlab_bin")
    else
        error_record "$EXIT_RUNTIME" 'MATLAB executable is unavailable; set PSEUDOCT_MATLAB to its path.'
    fi
fi
fi

# matlab_support MODE REQUEST RESULT SUMMARY ACTION (unused arguments empty): run the CLI bridge
# in MODE from tmp_dir, with the installed standalone or the repository MATLAB. Output goes to
# tmp_dir/matlab-diagnostics-support-MODE.log; the bridge status is returned.
matlab_support() {
    support_mode=$1
    (
    cd -- "$tmp_dir" || exit 69
    export PSEUDOCT_CLI_ROOT="$root_dir" PSEUDOCT_CLI_MODE="$support_mode" \
    PSEUDOCT_CLI_INPUT="$input_file" PSEUDOCT_CLI_REQUEST="$2" \
    PSEUDOCT_CLI_RESULT="${3:-}" PSEUDOCT_CLI_SUMMARY="${4:-}" \
    PSEUDOCT_CLI_INVOCATION="$invocation_id" PSEUDOCT_CLI_PROFILE="$profile" \
    PSEUDOCT_CLI_ACTION="$5" PSEUDOCT_CLI_HANDOFF="${credential_handoff:-}"
    if [ "$installed" -eq 1 ]; then
        export LD_LIBRARY_PATH=$mcr_ld_path
        "$standalone_exe" "$support_mode" >"$tmp_dir/matlab-diagnostics-support-$support_mode.log" 2>&1
        exit $?
    fi
    "$matlab_bin" -nodesktop -nosplash -nodisplay <<'MATLAB' \
        >"$tmp_dir/matlab-diagnostics-support-$support_mode.log" 2>&1
try
    root = getenv('PSEUDOCT_CLI_ROOT');
    addpath(root, '-begin');
    runtime_dirs = {'api'; 'cli'; 'gui'; 'orchestration'; 'backends'; ...
        'config'; 'io'; 'qc'};
    for ii = 1:length(runtime_dirs)
        path_here = fullfile(root, 'src', runtime_dirs{ii});
        if exist(path_here, 'dir') == 7
            addpath(genpath(path_here), '-begin');
        end
    end
    status = pseudoct_cli_bridge(getenv('PSEUDOCT_CLI_MODE'));
catch ME
    fprintf(2, 'pseudoct: MATLAB CLI support failed (%s).\n', ME.identifier);
    status = 70;
end
if ~exist('status', 'var') || ~isnumeric(status) || ~isscalar(status)
    status = 70;
end
exit(status);
MATLAB
    )
}

# run_headless PHASE REQUEST RESULT: run one headless phase by re-invoking this launcher's
# headless operation. Its stdout and stderr go through the presenter filter below, raw output
# is captured in tmp_dir/matlab-diagnostics-PHASE.log, and the child status is returned
# (69 if the transport itself fails).
run_headless() {
    phase=$1
    request_path=$2
    result_path=$3
    set +e
    python3 - "$self" "$request_path" \
        "$result_path" "$format" "$tmp_dir/matlab-diagnostics-$phase.log" \
        "$invocation_id" "$run_log_index" "$profile" \
        ${headless_args[@]+"${headless_args[@]}"} <<'PY'
import json
import os
import re
import selectors
import subprocess
import sys

launcher, request_path, result_path, output_format, diagnostics_path, \
    invocation_id, run_log_index, run_profile = sys.argv[1:9]
# Optional installed-standalone selection (--mcr / --mcr-root) follows the fixed arguments.
launcher_args = sys.argv[9:]
environment = os.environ.copy()
environment["PSEUDOCT_CLI_OUTPUT"] = "1"
# Non-secret correlation only: names the per-run log and a private index of
# its relative MR_PET path (the CLI scratch copy is removed on exit; the
# subject's own run log never is).
environment["PSEUDOCT_CLI_INVOCATION_ID"] = invocation_id
environment["PSEUDOCT_CLI_LOG_INDEX"] = run_log_index

# The public stage of a Local Current event (10 stages with DICOM output, 9
# for NIfTI-only) is assigned by the Local Current adapter/orchestrator and
# carried by the canonical event; the presenter blanks the STAGE cell on
# continuation rows while every JSONL record keeps the full stage. This
# transport passes stage values through: no raw-number remapping and no
# policy reading.
BARE_COMPILED_MARKER = re.compile(r"(?<!stage )(?<!stage\t)\[\d+/\d+\]", re.I)

def remap_stage(value):
    return value

# Recognize public TIME SUBJECT [n/m] STATUS rows by their fields, not column
# padding. The presenter uses --:--:-- when no source timestamp is available.
TABLE_ROW = re.compile(
    r"^((?:\d\d:\d\d:\d\d|--:--:--)[ \t]+\S+[ \t]+)(\[\d+/\d+\])"
    r"([ \t]+(?:ACTIVE|DONE|SKIPPED|INFO|WARN|ERROR|CANCELLED|VERIFIED)\b.*)$",
    re.S)

# Wrapped presenter rows have blank TIME, SUBJECT and STAGE cells and repeat
# STATUS at column 25. Their indentation is part of the table layout, so they
# are forwarded unstripped and are never treated as compiled markers.
TABLE_CONTINUATION = re.compile(
    r"^ {25}(?:ACTIVE|DONE|SKIPPED|INFO|WARN|ERROR|CANCELLED|VERIFIED) ")

def table_row_stage(text):
    return TABLE_ROW.match(text)

def remap_table_row(text):
    return text

def remap_stage_markers(text):
    return text

def redact_secrets(text):
    # Credentials are filtered before anything is persisted, including the raw
    # private capture below.
    return re.sub(
        r"(?i)(username|user|password|passphrase|account|token|secret)"
        r"([ \t]*[:=][ \t]*|[ \t]+)[^ \t,;]+",
        lambda match: match.group(1) + match.group(2) + "<redacted>", text)
if output_format == "jsonl":
    environment["PSEUDOCT_OUTPUT_FORMAT"] = "jsonl"
else:
    environment.pop("PSEUDOCT_OUTPUT_FORMAT", None)

def strip_prompts(text):
    candidate = text.lstrip()
    while candidate.startswith(">>"):
        candidate = candidate[2:].lstrip()
    return candidate

def sanitize_message(text):
    # Mirrors pseudo_CT_sanitize_message (src/io/pseudo_CT_sanitize_message.m); keep the two
    # in step. Structured callers sanitize only message fields; stage markers in free text
    # are preserved through generic slash-path redaction.
    def short_hash(value):
        hash_value = 5381
        for character in value:
            hash_value = (hash_value * 33 + ord(character)) % 4294967296
        return format(hash_value, "08x")

    stage_markers = []

    def hold_stage_marker(match):
        stage_markers.append(match.group(0))
        return "PSEUDOCTSTAGEMARKER" + str(len(stage_markers) - 1) + "-X"

    text = re.sub(r"(?i)\[(?:stage[ \t]+)?\d+/\d+\]",
                  hold_stage_marker, text)
    dicom_names = re.findall(
        r"(?i)(?:[A-Za-z]:\\|/)?[^ \t,;:()]*\.dcm", text)
    for name in dicom_names:
        text = text.replace(name, "DICOM-" + short_hash(name))
    # Redact path-shaped tokens only: absolute (/x, ~/x, ./x, ../x) tokens and
    # relative multi-segment tokens that have a segment naming a subject-data
    # directory (MR_PET, MR, pseudo_muMAP, tmp) or a segment ending in a file
    # extension. Relative prose such as registration/warping is preserved, as
    # is exactly the approved MR_PET/pseudoct-run-*.log disclosure.
    boundary = r"(?<![^\s=\'\"(\[<,;:])"
    text = re.sub(boundary + r"(?:~|\.{1,2})?/[^ \t,;:()]+", "<path>", text)
    text = re.sub(
        boundary + r"(?!MR_PET/pseudoct-run-[0-9A-Za-z-]+\.log(?![\w.\-/]))"
        r"(?=[\w.\-/]*?(?:(?<![\w.\-])(?:MR_PET|MR|pseudo_muMAP|tmp)(?![\w.\-])"
        r"|\.(?=[0-9]*[A-Za-z])[A-Za-z0-9]{1,5}(?![\w.\-])))"
        r"[\w.\-]+(?:/[\w.\-]+)+",
        "<path>", text)
    text = re.sub(r"[A-Za-z]:\\[^ \t,;:()]+", "<path>", text)
    text = re.sub(
        r"(?i)(username|user|password|passphrase|account|token|secret)"
        r"([ \t]*[:=][ \t]*|[ \t]+)[^ \t,;]+",
        lambda match: match.group(1) + match.group(2) + "<redacted>", text)
    text = re.sub(r"[\r\n]+", " | ", text)
    for index, marker in enumerate(stage_markers):
        text = text.replace("PSEUDOCTSTAGEMARKER" + str(index) + "-X", marker)
    return text

def sanitize_console_line(text):
    # Newlines delimit captured transport lines; preserve the terminator after
    # sanitizing the line content, matching the MATLAB sanitizer's treatment
    # of message text rather than displaying a trailing separator.
    if text.endswith("\r\n"):
        return sanitize_message(text[:-2]) + "\r\n"
    if text.endswith(("\n", "\r")):
        return sanitize_message(text[:-1]) + text[-1:]
    return sanitize_message(text)

def forward_line(text, channel):
    safe_text = sanitize_console_line(text)
    print(safe_text, end="" if text.endswith(("\n", "\r")) else "\n",
          file=sys.stderr if channel == "stderr" else sys.stdout, flush=True)

def matlab_noise(text):
    value = text.strip()
    if not value:
        return True
    lowered = " ".join(value.split()).lower()
    if lowered.startswith((
            "matlab is", "copyright", "the mathworks, inc.",
            "version ", "for product information", "to get started")):
        return True
    if lowered.startswith("pseudoct-headless: validation ready for "):
        return True
    if lowered in ("< m a t l a b (r) >", "august 16, 2010"):
        return True
    if value == ">>" or value.startswith(">>") and not strip_prompts(value):
        return True
    if "no window system found" in lowered or (
            "java option" in lowered and "mwt" in lowered and
            "ignored" in lowered):
        return True
    if lowered.startswith("adding ganymed-ssh2 to the java path"):
        return True
    if lowered.startswith("javaaddpath("):
        return True
    if lowered.startswith("just added ganymed-ssh2 to matlab's dynamic java classpath"):
        return True
    return False

text_header_state = {"seen": False, "suppressing_duplicate": False,
                     "rule_pending": False}
TABLE_HEADER = re.compile(r"^TIME\s+SUBJECT\s+STAGE\s+STATUS\s+MESSAGE\s*$")
TABLE_RULE = re.compile(r"^-{20,}\s*$")
header_marker = os.path.join(os.path.dirname(diagnostics_path),
                             "table-header-seen")

def is_header_continuation(text):
    value = text.strip()
    return (not value or value.startswith(("Started:", "Subjects:",
                                           "TIME      SUBJECT STAGE")) or
            value == "-" * 67)

class RedactingWriter:
    def __init__(self, stream):
        self.stream = stream

    def write(self, text):
        return self.stream.write(redact_secrets(text))

    def flush(self):
        return self.stream.flush()

    def close(self):
        return self.stream.close()

def write_line(channel, raw, diagnostics):
    text = raw.decode("utf-8", "replace")
    if channel == "stderr":
        diagnostics.write("[stderr] " + text)
        diagnostics.flush()
        # The headless exception identifier, message and stack are the only
        # diagnostics for a failed operation; keep them on the caller's stderr.
        if text.startswith("pseudoct-headless:"):
            forward_line(text, "stderr")
        return
    candidate = strip_prompts(text)
    if matlab_noise(candidate):
        diagnostics.write("[" + channel + "] " + text)
        diagnostics.flush()
        return
    if channel == "stdout" and BARE_COMPILED_MARKER.search(candidate) and \
            not candidate.lstrip().startswith("{") and \
            not table_row_stage(candidate.rstrip("\r\n")) and \
            not TABLE_CONTINUATION.match(text.rstrip("\r\n")):
        # Compiled-runner and SPM batch [n/m] markers are log-only: they are
        # not orchestration stages and never appear in public output. Public
        # presenter table rows and JSON progress records are exempt.
        diagnostics.write("[stdout compiled marker] " + text)
        diagnostics.flush()
        return
    if channel == "stdout" and output_format != "jsonl":
        header_line = candidate.rstrip("\r\n")
        # Each MATLAB phase (validate, submit) is a new process with its own
        # presenter, which prints the table header again. The first header
        # (and its rule) is public output; later ones are diverted. The
        # "seen" marker is a file next to the diagnostics so it survives
        # across the per-phase transport processes. Rows are never touched.
        if text_header_state["rule_pending"]:
            text_header_state["rule_pending"] = False
            if TABLE_RULE.match(header_line):
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
        if TABLE_HEADER.match(header_line):
            if os.path.exists(header_marker):
                text_header_state["rule_pending"] = True
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            try:
                open(header_marker, "w").close()
            except OSError:
                pass
        if text_header_state["suppressing_duplicate"]:
            if is_header_continuation(header_line):
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            text_header_state["suppressing_duplicate"] = False
        if header_line.startswith("pseudoCT |"):
            if text_header_state["seen"]:
                text_header_state["suppressing_duplicate"] = True
                diagnostics.write("[stdout duplicate header] " + text)
                diagnostics.flush()
                return
            text_header_state["seen"] = True
    if channel == "stdout" and output_format == "jsonl":
        try:
            value = json.loads(candidate)
        except Exception:
            forward_line(candidate, "stderr")
            return
        if isinstance(value, dict) and value.get("type") == "progress":
            if isinstance(value.get("message"), str):
                value["message"] = remap_stage_markers(
                    sanitize_message(value["message"]))
            if "stage" in value:
                mapped_stage = remap_stage(value["stage"])
                if mapped_stage is None:
                    value.pop("stage", None)
                    value.pop("stage_reason", None)
                else:
                    value["stage"] = mapped_stage
            for field_name in ("subject", "stage", "status", "job"):
                field_value = value.get(field_name)
                missing_context = field_value is None or field_value == "" or \
                    (isinstance(field_value, str) and
                     field_value.lower() in ("unavailable", "null"))
                if field_name == "subject" and isinstance(field_value, str) and \
                        field_value.lower() == "run":
                    missing_context = True
                if missing_context:
                    value.pop(field_name, None)
                    value.pop(field_name + "_reason", None)
            print(json.dumps(value, separators=(",", ":"), ensure_ascii=False), flush=True)
        else:
            forward_line(candidate, "stderr")
        return
    if channel == "stdout":
        try:
            value = json.loads(candidate)
        except Exception:
            if TABLE_CONTINUATION.match(text.rstrip("\r\n")):
                forward_line(text, "stdout")
                return
            body = candidate.rstrip("\r\n")
            forward_line(remap_table_row(body) + candidate[len(body):], "stdout")
        else:
            if isinstance(value, dict) and value.get("type") == "progress":
                message = remap_stage_markers(
                    sanitize_message(str(value.get("message", ""))))
                public_stage = remap_stage(value.get("stage", ""))
                fields = [value.get("timestamp", ""), value.get("level", ""),
                          value.get("subject", ""), public_stage or "",
                          value.get("status", ""), message]
                print(" | ".join(str(item) for item in fields if item not in (None, "")),
                      flush=True)
            else:
                forward_line(candidate, "stdout")

try:
    diagnostics_fd = os.open(
        diagnostics_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    diagnostics = RedactingWriter(
        os.fdopen(diagnostics_fd, "w", encoding="utf-8", newline=""))
except OSError:
    print("pseudoct: could not open diagnostics capture",
          file=sys.stderr, flush=True)
    raise SystemExit(70)

selector = None
try:
    process = subprocess.Popen([launcher] + launcher_args + [request_path, result_path], env=environment,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               bufsize=0)
    selector = selectors.DefaultSelector()
    streams = {}
    for channel, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
        selector.register(stream, selectors.EVENT_READ, channel)
        streams[stream.fileno()] = {"channel": channel, "stream": stream, "pending": b""}
    while selector.get_map():
        for key, _ in selector.select():
            stream = key.fileobj
            state = streams[stream.fileno()]
            chunk = os.read(stream.fileno(), 4096)
            if not chunk:
                selector.unregister(stream)
                if state["pending"]:
                    write_line(state["channel"], state["pending"], diagnostics)
                stream.close()
                continue
            state["pending"] += chunk
            while b"\n" in state["pending"]:
                line, state["pending"] = state["pending"].split(b"\n", 1)
                write_line(state["channel"], line + b"\n", diagnostics)
    run_status = process.wait()
except Exception as error:
    try:
        diagnostics.write("[transport] launcher=" + repr(launcher) +
                          " error=" + repr(error) + "\n")
        diagnostics.flush()
    except OSError:
        pass
    # The caller maps launch/transport failure to the documented runtime code 69.
    run_status = 69
finally:
    if selector is not None:
        try:
            selector.close()
        except Exception:
            pass
    try:
        diagnostics.close()
    except OSError:
        pass
raise SystemExit(run_status)
PY
    run_status=$?
    set -u
    return "$run_status"
}

if ! matlab_support prepare_validate "$validate_request" '' '' '' ; then
    error_record "$EXIT_RUNTIME" 'MATLAB could not serialize the v2 request MAT.'
fi
run_headless validate "$validate_request" "$validate_result"
validate_launcher_status=$?
if [ ! -s "$validate_result" ]; then
    error_record "$EXIT_RUNTIME" "Validation launcher returned no result MAT (status $validate_launcher_status)."
fi
if ! matlab_support verify_result '' "$validate_result" "$summary_file" validate; then
    error_record "$EXIT_RUNTIME" 'Validation result MAT failed schema/binding verification.'
fi
operation_phase=validate_done

if [ "$action" = run ]; then
    python3 - "$summary_file" <<'PY' >/dev/null 2>&1
import sys
v = open(sys.argv[1], encoding="utf-8").read().splitlines()
raise SystemExit(0 if v and v[0] == "ready" and v[8] == "validate" else 1)
PY
    validation_ready=$?
    if [ "$validation_ready" -ne 0 ]; then
        python3 - "$summary_file" "$invocation_id" "$profile" "$format" <<'PY'
import json, sys
values = open(sys.argv[1], encoding="utf-8").read().splitlines()
if len(values) < 10:
    raise SystemExit(69)
status, code, auth, submission, backend, science, dispatch, ids, action, message = values[:10]
code = "" if code == "-" else code
ids = "" if ids == "-" else ids
message = "" if message == "-" else message
record = {"type":"result", "invocation_id":sys.argv[2], "action":"validate", "profile":sys.argv[3],
          "outcome":"validation_failed", "headless_dispatch_returned":True,
          "dispatch_status":dispatch, "submission_status":submission,
          "scheduler_submission_accepted":False, "scientific_completion":None,
          "scientific_completion_reason":"Validation did not run scientific processing.",
          "job_ids":[int(x) for x in ids.split()] if ids else [],
          "error_code":code or None, "error_message":message or None}
if sys.argv[4] == "jsonl": print(json.dumps(record, separators=(",", ":")))
else:
    print("Validation failed: " + (code or status))
    if message: print(message)
PY
        exit "$EXIT_VALIDATION"
    fi

    if [ "$backend" != local ]; then
        if [ -z "$credential_handoff" ]; then
            if [ ! -r /dev/tty ] || [ ! -w /dev/tty ] || \
                    ! (tty -s < /dev/tty 2>/dev/null); then
                error_record "$EXIT_AUTH" 'Remote submission requires a terminal prompt or a single-use credential handoff.' AUTHENTICATION_REQUIRED
            fi
            printf 'Remote username: ' > /dev/tty
            IFS= read -r username < /dev/tty || error_record "$EXIT_AUTH" 'Username prompt was cancelled.'
            [ -n "$username" ] || error_record "$EXIT_AUTH" 'Username cannot be empty.'
            tty_state=$(stty -g < /dev/tty 2>/dev/null) || error_record "$EXIT_AUTH" 'Cannot disable terminal echo for password input.'
            stty -echo < /dev/tty 2>/dev/null || error_record "$EXIT_AUTH" 'Cannot disable terminal echo for password input.'
            printf 'Remote password (not echoed): ' > /dev/tty
            if IFS= read -r password < /dev/tty; then
                stty "$tty_state" < /dev/tty 2>/dev/null || true
                tty_state=''
                printf '\n' > /dev/tty
            else
                stty "$tty_state" < /dev/tty 2>/dev/null || true
                tty_state=''
                error_record "$EXIT_AUTH" 'Password prompt was cancelled.'
            fi
            [ -n "$password" ] || error_record "$EXIT_AUTH" 'Password cannot be empty.'
            [ -d /dev/shm ] && [ -w /dev/shm ] && [ -x /dev/shm ] && \
                [ "$(stat -f -c %T /dev/shm 2>/dev/null)" = tmpfs ] || \
                error_record "$EXIT_AUTH" 'Private memory-backed credential staging is unavailable.'
            secret_dir=$(mktemp -d /dev/shm/pseudoct-cli-credentials-XXXXXX 2>/dev/null) || \
                error_record "$EXIT_AUTH" 'Private memory-backed credential staging is unavailable.'
            chmod 00700 "$secret_dir" || error_record "$EXIT_AUTH" 'Credential staging permissions are unsafe.'
            (umask 077; printf '%s\n%s\n' "$username" "$password" > "$secret_dir/login") || \
                error_record "$EXIT_AUTH" 'Credential staging failed.'
            chmod 600 "$secret_dir/login" || error_record "$EXIT_AUTH" 'Credential staging permissions are unsafe.'
            unset username password
            handoff_output=$handoff_registry
            if ! (cd -- "$tmp_dir" || exit 69
                export PSEUDOCT_CLI_ROOT="$root_dir" PSEUDOCT_CLI_MODE=store_credentials \
                PSEUDOCT_CLI_SECRET_FILE="$secret_dir/login" \
                PSEUDOCT_CLI_HANDOFF_OUTPUT="$handoff_output"
                if [ "$installed" -eq 1 ]; then
                    export LD_LIBRARY_PATH=$mcr_ld_path
                    "$standalone_exe" store_credentials >"$tmp_dir/matlab-diagnostics-store-credentials.log" 2>&1
                    exit $?
                fi
                "$matlab_bin" -nodesktop -nosplash -nodisplay <<'MATLAB' \
                    >"$tmp_dir/matlab-diagnostics-store-credentials.log" 2>&1
try
    root = getenv('PSEUDOCT_CLI_ROOT');
    addpath(root, '-begin');
    addpath(genpath(fullfile(root, 'src', 'api')), '-begin');
    addpath(genpath(fullfile(root, 'src', 'cli')), '-begin');
    status = pseudoct_cli_bridge('store_credentials');
catch ME
    fprintf(2, 'pseudoct: credential handoff failed (%s).\n', ME.identifier);
    status = 70;
end
exit(status);
MATLAB
                )
            then
                error_record "$EXIT_AUTH" 'Secure single-use credential handoff could not be created.' AUTHENTICATION_FAILED
            fi
            credential_handoff=$(cat "$handoff_output")
            [ -n "$credential_handoff" ] || error_record "$EXIT_AUTH" 'Secure single-use credential handoff could not be created.'
            python3 - "$secret_dir/login" <<'PY' >/dev/null 2>&1 || true
import os, sys
try:
    p=sys.argv[1]
    with open(p,"r+b",buffering=0) as f: f.write(b"\0"*os.fstat(f.fileno()).st_size)
    os.unlink(p); os.rmdir(os.path.dirname(p))
except OSError: pass
PY
            secret_dir=''
        fi
    fi
    if ! matlab_support prepare_submit "$submit_request" "$validate_result" '' '' submit; then
        error_record "$EXIT_RUNTIME" 'Validated job could not be serialized for submit.'
    fi
    operation_phase=submit_called
    run_headless submit "$submit_request" "$submit_result"
    submit_launcher_status=$?
    if [ ! -s "$submit_result" ]; then
        error_record "$EXIT_RUNTIME" "Submit launcher returned no result MAT (status $submit_launcher_status)."
    fi
    if ! matlab_support verify_result '' "$submit_result" "$summary_file" submit; then
        error_record "$EXIT_RUNTIME" 'Submit result MAT failed schema/binding verification.'
    fi
fi

python3 - "$summary_file" "$invocation_id" "$profile" "$action" "$format" "$backend" "$run_log_index" <<'PY'
import json, re, sys
summary, invocation, profile, action, output_format, backend, log_index = sys.argv[1:]
run_logs = []
try:
    with open(log_index, encoding="utf-8") as index:
        for entry in index.read().splitlines():
            number, _, relative = entry.partition("\t")
            if number.isdigit() and re.fullmatch(
                    r"MR_PET/pseudoct-run-\d{8}T\d{6}Z-[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}\.log",
                    relative):
                run_logs.append({"subject": int(number), "path": relative})
except OSError:
    pass
values = open(summary, encoding="utf-8").read().splitlines()
if len(values) < 10:
    print("pseudoct: verified result summary is incomplete.", file=sys.stderr)
    raise SystemExit(69)
status, error_code, auth, submission, result_backend, science, dispatch, ids, result_action, message = values[:10]
error_code = "" if error_code == "-" else error_code
ids = "" if ids == "-" else ids
message = "" if message == "-" else message
job_ids = [int(v) for v in ids.split()] if ids else []
accepted = submission == "accepted"
if result_action == "validate":
    outcome = "validation_succeeded" if status == "ready" else "validation_failed"
elif error_code in {"AUTHENTICATION_FAILED", "NO_ACCOUNTS", "ACCOUNT_QUERY_FAILED", "CREDENTIAL_ERASE_FAILED", "CREDENTIAL_STORAGE_FAILED", "HOST_KEY_UNAVAILABLE", "INVALID_GROUP_ACCOUNT"}:
    outcome = "authentication_failed"
elif error_code in {"INVALID_REQUEST", "PROFILE_NOT_ALLOWED", "STALE_RESOLVED_JOB"}:
    outcome = "validation_failed"
elif science == "completed":
    outcome = "scientific_completed"
elif science == "failed":
    outcome = "scientific_failed"
elif result_backend == "local" and status == "failed":
    # Verified failures were handled above (science == "failed"); a failed local
    # dispatch without that verdict is unverified (exit 68).
    outcome = "scientific_completion_unverified"
elif accepted:
    outcome = "submission_accepted_completion_unverified"
elif submission in {"rejected", "unresolved"} or status == "failed":
    outcome = "submission_failed"
elif dispatch == "dispatched":
    outcome = "dispatch_returned_submission_unconfirmed"
else:
    outcome = "dispatch_not_attempted"
science_value = science if science in {"completed", "failed"} else None
science_reason = None if science_value is not None else (
    "Validation does not execute scientific processing." if action == "validate" else
    "The bound result reports scientific_completion=" + science + "; dispatch or scheduler acknowledgement is not completion evidence.")
record = {
    "type": "result", "invocation_id": invocation,
    "action": "validate" if action == "validate" else "submit",
    "profile": profile, "outcome": outcome,
    "headless_dispatch_returned": True,
    "dispatch_status": dispatch,
    "scheduler_submission_accepted": accepted,
    "submission_status": submission,
    "authentication_status": auth,
    "scientific_completion": science_value,
    "scientific_completion_status": science,
    "scientific_completion_reason": science_reason,
    "backend": result_backend, "job_ids": job_ids,
    "group_account": None if result_backend != "mlsc" else None,
    "group_account_reason": "Not exposed by the CLI result summary; inspect the bound MAT result.",
    "error_code": error_code or None,
    "error_message": message or None,
}

if result_action == "validate":
    code = 0 if status == "ready" else 65
elif error_code in {"AUTHENTICATION_FAILED", "NO_ACCOUNTS", "ACCOUNT_QUERY_FAILED", "CREDENTIAL_ERASE_FAILED", "CREDENTIAL_STORAGE_FAILED", "HOST_KEY_UNAVAILABLE", "INVALID_GROUP_ACCOUNT"}:
    code = 66
elif error_code in {"INVALID_REQUEST", "PROFILE_NOT_ALLOWED", "STALE_RESOLVED_JOB"}:
    code = 65
elif status == "submitted" and not error_code and science == "completed":
    code = 0
elif result_backend == "local" or science == "failed":
    code = 68
elif accepted:
    code = 68
elif submission in {"rejected", "unresolved"} or status == "failed" or error_code:
    code = 67
else:
    code = 69
record["exit_code"] = code
if output_format == "jsonl":
    print(json.dumps(record, separators=(",", ":"), ensure_ascii=False))
else:
    print("pseudoct " + ("validation" if action == "validate" else "run") + ": " + outcome)
    print("  profile: " + profile)
    print("  headless dispatch returned: yes")
    print("  dispatch status: " + dispatch)
    print("  scheduler submission accepted: " + ("yes" if accepted else "no (" + submission + ")"))
    if science_value is None:
        print("  scientific completion: unavailable (" + science + ")")
        print("  reason: " + science_reason)
    else:
        print("  scientific completion: " + science_value)
    if job_ids: print("  scheduler job IDs: " + ", ".join(str(v) for v in job_ids))
    for item in run_logs:
        print("  run log" + (" (subject %d)" % item["subject"] if len(run_logs) > 1 else "") + ": " + item["path"])
    if not run_logs and outcome in {"scientific_failed", "submission_failed"}:
        print("  No subject run log was created because the output location could not be established.")
    if error_code: print("  error: " + error_code + ": " + message)
raise SystemExit(code)
PY
result_status=$?
exit "$result_status"
}

if [ "$#" -lt 1 ]; then
    usage >&2
    exit "$EXIT_USAGE"
fi
operation=$1
shift
case "$operation" in
    -h|--help) usage; exit 0 ;;
    --list-releases)
        [ "$#" -eq 0 ] || fail_op '--list-releases takes no other arguments' "$EXIT_USAGE"
        list_releases ;;
    run) op_run "$@" ;;
    headless) op_headless "$@" ;;
    resolve) op_resolve "$@" ;;
    *) fail_op "unknown operation: $operation (see --help)" "$EXIT_USAGE" ;;
esac
